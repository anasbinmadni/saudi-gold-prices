---
import LiveTicker from './LiveTicker.astro';

interface Props {
  title: string;
  description: string;
  breadcrumbCurrent: string;
}

const { title, description, breadcrumbCurrent } = Astro.props;
---

<nav class="max-w-6xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
  <ol class="flex items-center space-x-2 space-x-reverse">
    <li><a href="/" class="hover:text-gold-700 font-medium">الرئيسية</a></li>
    <li><span class="mx-1">/</span></li>
    <li class="text-gold-700 font-semibold">{breadcrumbCurrent}</li>
  </ol>
</nav>

<header class="border-b border-gray-200 pb-6 mb-8 text-right max-w-6xl mx-auto px-4">
  <LiveTicker />
  <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
    {title}
  </h1>
  <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed">
    {description}
  </p>
</header>