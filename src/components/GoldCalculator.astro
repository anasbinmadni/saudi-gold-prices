---
---
<section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-10" id="calculator">
  <div class="border-b border-gray-100 pb-4 mb-6">
    <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
      <span class="text-amber-600">🧮</span> حاسبة أسعار الذهب في السعودية (شراء وبيع)
    </h2>
    <p class="text-sm text-gray-500 mt-1">
      احسب القيمة التقديرية للذهب بناءً على العيار، الوزن بالجرام، والمصنعية مع ضريبة القيمة المضافة (15%).
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <!-- Karat Selection -->
    <div>
      <label for="calc-karat" class="block text-xs font-semibold text-gray-700 mb-1">العيار المطلوب</label>
      <select id="calc-karat" class="w-full bg-gray-50 border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-amber-500">
        <option value="24">عيار 24 (ذهب خالص)</option>
        <option value="22">عيار 22</option>
        <option value="21" selected>عيار 21 (الأكثر تداولاً)</option>
        <option value="18">عيار 18</option>
      </select>
    </div>

    <!-- Weight in Grams -->
    <div>
      <label for="calc-weight" class="block text-xs font-semibold text-gray-700 mb-1">الوزن (بالجرام)</label>
      <input type="number" id="calc-weight" value="10" min="0.1" step="0.1" class="w-full bg-gray-50 border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-amber-500" />
    </div>

    <!-- Workmanship Fee -->
    <div>
      <label for="calc-making" class="block text-xs font-semibold text-gray-700 mb-1">المصنعية للجرام (اختياري)</label>
      <input type="number" id="calc-making" value="25" min="0" step="1" class="w-full bg-gray-50 border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-amber-500" />
      <span class="text-[11px] text-gray-500">المتوسط في المحلات: 15 - 50 ر.س</span>
    </div>
  </div>

  <!-- Calculation Results Output -->
  <div class="bg-amber-50/60 border border-amber-200 rounded-xl p-4 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
    <div class="p-2">
      <span class="block text-xs text-gray-500 mb-1">قيمة الذهب الصافي</span>
      <span id="res-gold-val" class="font-bold text-gray-900 text-lg">0.00</span> <span class="text-xs text-gray-600">ر.س</span>
    </div>
    <div class="p-2">
      <span class="block text-xs text-gray-500 mb-1">إجمالي المصنعية</span>
      <span id="res-making-val" class="font-bold text-gray-900 text-lg">0.00</span> <span class="text-xs text-gray-600">ر.س</span>
    </div>
    <div class="p-2">
      <span class="block text-xs text-gray-500 mb-1">ضريبة المصنعية (15%)</span>
      <span id="res-tax-val" class="font-bold text-gray-900 text-lg">0.00</span> <span class="text-xs text-gray-600">ر.س</span>
    </div>
    <div class="p-2 bg-amber-100/70 rounded-lg border border-amber-300">
      <span class="block text-xs text-amber-900 font-semibold mb-1">السعر الإجمالي للشراء</span>
      <span id="res-total-val" class="font-extrabold text-amber-800 text-xl">0.00</span> <span class="text-xs font-bold text-amber-900">ر.س</span>
    </div>
  </div>
  
  <p class="text-xs text-gray-500 mt-3 text-right">
    * تنبيه: عند بيع الذهب المستعمل لمحلات الصاغة، يتم احتساب قيمة الذهب الصافي فقط بدون مصنعية أو ضريبة.
  </p>
</section>

<script>
  // Dynamic Calculation Logic
  function calculateGold() {
    const karat = document.getElementById('calc-karat').value;
    const weight = parseFloat(document.getElementById('calc-weight').value) || 0;
    const makingPerGram = parseFloat(document.getElementById('calc-making').value) || 0;

    // Fallback spot rate if window data isn't set yet (approximate benchmark)
    const baseRate24K = window.currentGram24K || 315.5; 
    const karatRatios = { '24': 1, '22': 22/24, '21': 21/24, '18': 18/24 };

    const gramRate = baseRate24K * karatRatios[karat];
    const rawGoldTotal = gramRate * weight;
    const makingTotal = makingPerGram * weight;
    const taxTotal = makingTotal * 0.15; // 15% VAT on workmanship only
    const grandTotal = rawGoldTotal + makingTotal + taxTotal;

    document.getElementById('res-gold-val').textContent = rawGoldTotal.toFixed(2);
    document.getElementById('res-making-val').textContent = makingTotal.toFixed(2);
    document.getElementById('res-tax-val').textContent = taxTotal.toFixed(2);
    document.getElementById('res-total-val').textContent = grandTotal.toFixed(2);
  }

  // Event Listeners
  ['calc-karat', 'calc-weight', 'calc-making'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateGold);
  });

  // Expose recalculate globally so the rates fetcher can invoke it with live rates
  window.recalculateGold = calculateGold;
  calculateGold();
</script>