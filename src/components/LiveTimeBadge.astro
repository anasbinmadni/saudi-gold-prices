---
// src/components/LiveTimeBadge.astro
export interface Props {
  text?: string;
}
const { text = "تحديث فوري 🇸🇦 بتوقيت الرياض:" } = Astro.props;
---

<div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs md:text-sm font-semibold mb-4 shadow-sm">
  <span class="relative flex h-2.5 w-2.5">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
  </span>
  <span>{text}</span>
  <span class="live-timestamp bg-white px-2 py-0.5 rounded text-emerald-900 shadow-sm border border-emerald-100 whitespace-nowrap" dir="ltr">
    جاري التحديث...
  </span>
</div>

<script>
  function updateSaudiTime() {
    // Claude SEO Recommendation: Full Date + Time format
    const saudiTime = new Date().toLocaleString('ar-SA', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric',
      hour: '2-digit', 
      minute: '2-digit', 
      timeZone: 'Asia/Riyadh' 
    });
    
    const timeElements = document.querySelectorAll('.live-timestamp');
    timeElements.forEach(el => {
      el.textContent = saudiTime;
    });
  }
  
  // Run on load
  updateSaudiTime();
</script>