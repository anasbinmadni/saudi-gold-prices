<header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center gap-2">
        <span class="text-2xl">🪙</span>
        <a href="/" class="text-xl font-extrabold text-gold-700 tracking-tight hover:text-gold-600 transition">
          أسعار الذهب<span class="text-gray-900"> السعودية</span>
        </a>
      </div>
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex gap-6">
        <a href="/" class="text-sm font-semibold text-gray-700 hover:text-gold-600 transition">الرئيسية</a>
        <a href="/bullion" class="text-sm font-semibold text-gray-700 hover:text-gold-600 transition">السبائك والجنيهات</a>
