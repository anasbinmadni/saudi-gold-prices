---
// src/components/Breadcrumb.astro
export interface Props {
  currentPage: string;
}

const { currentPage } = Astro.props;
---

<nav class="max-w-7xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
  <ol class="flex items-center space-x-2 space-x-reverse">
    <li><a href="/" class="hover:text-amber-600 font-medium transition">الرئيسية</a></li>
    <li><span class="mx-1">/</span></li>
    <li class="text-amber-700 font-semibold" aria-current="page">{currentPage}</li>
  </ol>
</nav>