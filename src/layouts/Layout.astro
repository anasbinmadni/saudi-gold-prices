---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const todayDate = new Date().toISOString().split('T')[0];
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Preconnect to API Worker and Google Fonts to improve LCP -->
  <link rel="preconnect" href="https://saudi-gold-api.2019ag138.workers.dev" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Non-blocking Font Loading to fix render-blocking resources -->
  <link 
    rel="preload" 
    as="style" 
    href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" 
  />
  <link 
    rel="stylesheet" 
    href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" 
    media="print" 
    onload="this.media='all'" 
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" />
  </noscript>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_SA" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="أسعار الذهب مباشر بالسعودية" />

  <!-- Google Analytics 4 (Deferred to minimize main-thread work) -->
  <script is:inline defer src="https://www.googletagmanager.com/gtag/js?id=G-0YPCJE6C6D"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0YPCJE6C6D');
  </script>

  <!-- Google AdSense (Deferred execution to prevent render blocking) -->
  <script is:inline defer src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7795085851692471" crossorigin="anonymous"></script>

  <!-- AEO & Structured Data (Breadcrumbs, Pricing, FAQ) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "الرئيسية",
            "item": Astro.site
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "أسعار الذهب اليوم في السعودية",
            "item": canonicalURL
          }
        ]
      },
      {
        "@type": "FinancialProduct",
        "name": "سعر الذهب عيار 21 اليوم في السعودية",
        "description": "تحديث مباشر لأسعار الذهب عيار 21 و24 بيع وشراء في محلات الذهب السعودية بالريال والدولار",
        "feesAndCommissionsSpecification": "شامل الضريبة وبدون مصنعية",
        "category": "Precious Metals",
        "currency": "SAR"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "كم سعر بيع وشراء الذهب عيار 21 اليوم في السعودية؟",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "يتم تسعير جرام الذهب عيار 21 اليوم في السعودية بدون مصنعية بسعر الشراء من المحلات وسعر البيع للأفراد وفقاً لتحديثات البورصة العالمية اللحظية بالريال السعودي."
            }
          },
          {
            "@type": "Question",
            "name": "كم تبلغ قيمة مصنعية الذهب في محلات السعودية؟",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "تتراوح مصنعية الذهب في السعودية بين 15 إلى 50 ريال للجرام حسب التصميم، وتبلغ ضريبة القيمة المضافة 15% على المصنعية فقط في المشغولات والسبائك الاستثمارية المعفاة."
            }
          }
        ]
      }
    ]
  })} />
</head>
<body class="bg-gray-50 text-gray-900 font-arabic antialiased min-h-screen flex flex-col">
  
  <SiteHeader />
  
  <div class="flex-grow">
    <slot />
  </div>

  <SiteFooter />
  
</body>
</html>