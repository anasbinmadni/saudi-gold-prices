---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  // Naye SEO Props (Claude ki recommendations ke mutabiq)
  faq?: { question: string; answer: string }[];
  modifiedDate?: string;
}

const { 
  title, 
  description, 
  faq, 
  // Agar manually date na di jaye, to build time ko modified date manega
  modifiedDate = new Date().toISOString() 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Dynamic Schema Builder
const schemaGraph: any[] = [
  // 1. WebPage Schema (For dateModified / Freshness)
  {
    "@type": "WebPage",
    "@id": canonicalURL,
    "url": canonicalURL,
    "name": title,
    "description": description,
    "dateModified": modifiedDate,
    "inLanguage": "ar-SA"
  },
  // 2. BreadcrumbList Schema
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "الرئيسية",
        "item": Astro.site
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": title,
        "item": canonicalURL
      }
    ]
  },
  // 3. FinancialProduct Schema
  {
    "@type": "FinancialProduct",
    "name": "سعر الذهب عيار 21 اليوم في السعودية",
    "description": "تحديث مباشر لأسعار الذهب عيار 21 و24 بيع وشراء في محلات الذهب السعودية بالريال والدولار",
    "feesAndCommissionsSpecification": "شامل الضريبة وبدون مصنعية",
    "category": "Precious Metals",
    "currency": "SAR"
  }
];

// 4. FAQ Schema (Sirf us page par add hoga jis mein FAQ pass kiye jayenge)
if (faq && faq.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  });
}
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Added: Favicon SVG -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Optimized Premium Arabic Font (Cairo) -->
  <link 
    rel="preload" 
    as="style" 
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700;800&display=swap" 
  />
  <link 
    rel="stylesheet" 
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700;800&display=swap" 
    media="print" 
    onload="this.media='all'" 
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@500;700;800&display=swap" />
  </noscript>

  <style is:global>
    html, body {
      font-family: 'Cairo', sans-serif !important;
    }
  </style>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_SA" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="أسعار الذهب مباشر بالسعودية" />

  <!-- Smart Non-Blocking Loader for GA4 & AdSense (Optimized to 5 seconds) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0YPCJE6C6D');

    function loadThirdPartyScripts() {
      if (window.scriptsLoaded) return;
      window.scriptsLoaded = true;

      // 1. Load Google Analytics 4
      const gaScript = document.createElement('script');
      gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-0YPCJE6C6D';
      gaScript.async = true;
      document.head.appendChild(gaScript);

      // 2. Load Google AdSense
      const adsScript = document.createElement('script');
      adsScript.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7795085851692471';
      adsScript.async = true;
      adsScript.crossOrigin = 'anonymous';
      document.head.appendChild(adsScript);
    }

    // Trigger on first human interaction or after 5s idle window
    ['touchstart', 'scroll', 'mousemove', 'keydown'].forEach(event => {
      window.addEventListener(event, loadThirdPartyScripts, { once: true, passive: true });
    });
    setTimeout(loadThirdPartyScripts, 5000);
  </script>

  <!-- Structured Data JSON-LD (Dynamically Injected) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": schemaGraph
  })} />
</head>
<body class="bg-gray-50 text-gray-900 antialiased min-h-screen flex flex-col">
  <SiteHeader />
  <div class="flex-grow">
    <slot />
  </div>
  <SiteFooter />
</body>
</html>