---
import Layout from '../layouts/Layout.astro';

// Naye SEO & UI Components
import Breadcrumb from '../components/Breadcrumb.astro';
import LiveTimeBadge from '../components/LiveTimeBadge.astro';
import AdBanner from '../components/AdBanner.astro';

// AEO-Optimized FAQ Data (Will be passed to Layout for JSON-LD Schema)
const faqData = [
  {
    question: "هل الجنيه الذهب معفى من الضريبة في السعودية؟",
    answer: "يخضع الجنيه الذهب لضريبة القيمة المضافة (15%) على قيمة المصنعية فقط، وليس على إجمالي قيمة الذهب، لأنه لا يصل إلى نسبة النقاء المطلوبة للإعفاء الكامل (99.9%)."
  },
  {
    question: "ما هي أشهر ماركات السبائك في السعودية؟",
    answer: "تتوفر في الأسواق ماركات موثوقة ومختومة مثل سبائك الراجحي، بامب (PAMP)، وفالكامبي (Valcambi). جميعها ممتازة طالما تحمل ختم النقاء وتأتي في غلافها الأصلي."
  },
  {
    question: "هل أفتح غلاف السبيكة بعد شرائها؟",
    answer: "لا يُنصح أبداً بفتح الغلاف البلاستيكي الذي يحمل الرقم التسلسلي والشهادة. فتح الغلاف قد يُفقد السبيكة جزءاً من قيمتها عند إعادة البيع لاضطرار التاجر لفحصها مجدداً."
  }
];

// Fallback static data
const bullions = [
  { item: 'سبيكة 1 جرام (عيار 24)', priceSAR: '347.00', purity: '99.9%' },
  { item: 'سبيكة 5 جرام (عيار 24)', priceSAR: '1,640.60', purity: '99.9%' },
  { item: 'سبيكة 10 جرام (عيار 24)', priceSAR: '3,218.10', purity: '99.9%' },
  { item: 'أونصة الذهب (31.1 جرام)', priceSAR: '9,812.05', purity: '99.9%' },
  { item: 'سبيكة 50 جرام (عيار 24)', priceSAR: '15,853.00', purity: '99.9%' },
  { item: 'سبيكة 100 جرام (عيار 24)', priceSAR: '31,644.00', purity: '99.9%' },
  { item: 'كيلو ذهب (1000 جرام)', priceSAR: '315,500.00', purity: '99.9%' },
  { item: 'جنيه ذهب سعودي (8 جرام)', priceSAR: '2,208.80', purity: 'عيار 21' }
];
---

<Layout 
  title="أسعار السبائك والجنيه الذهب اليوم في السعودية | تحديث مباشر"
  description="تابع أسعار سبائك الذهب (عيار 24) والجنيهات الذهبية في السعودية محدثة لحظياً. أسعار أونصة الذهب، سبيكة 10 جرام، والكيلو مع تفاصيل الإعفاء الضريبي."
  faq={faqData}
>
  <Breadcrumb currentPage="السبائك والجنيهات" />

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      
      <LiveTimeBadge text="تحديث فوري 🇸🇦 للسبائك:" />

      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
        أسعار سبائك الذهب والجنيهات في السعودية
      </h1>
      
      <!-- Ali Abdaal Style Highlights -->
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed mb-3">
        تُعد سبائك الذهب عيار 24 (بنقاء 99.9%) الملاذ الآمن والأفضل للاستثمار، حيث تتميز بكونها <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">معفاة تماماً من ضريبة القيمة المضافة (VAT)</span> في السعودية. تجد أدناه التسعير المباشر لجميع الأوزان ابتداءً من جرام واحد وحتى سبيكة الكيلو.
      </p>

      <!-- Source Citation (E-E-A-T) -->
      <p class="text-xs text-gray-500 flex items-center gap-1">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>بيانات مستمدة برمجياً من الشاشة العالمية (Spot Market) وخوارزميات ZATCA.</span>
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN CONTENT (8 Columns) -->
      <main class="lg:col-span-8 space-y-10">
        
        <AdBanner />

        <!-- Bullion Live Rates Table -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-4 md:px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex flex-wrap justify-between items-center gap-2">
            <h2 class="font-bold text-base md:text-lg text-gray-800 flex items-center gap-2">
              <span>🪙</span> جدول أسعار السبائك والجنيهات (تحديث مباشر)
            </h2>
            <span class="text-xs font-semibold text-emerald-900 bg-emerald-100 px-2 py-1 rounded shadow-sm border border-emerald-200">الأسعار معفاة من الضريبة</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[500px]">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4 whitespace-nowrap">الصنف والوزن</th>
                  <th class="py-3 px-4 whitespace-nowrap">السعر التقديري للمستهلك (SAR)</th>
                  <th class="py-3 px-4 whitespace-nowrap">درجة النقاء</th>
                </tr>
              </thead>
              <tbody id="bullion-table-body" class="divide-y divide-gray-200 text-sm">
                {bullions.map((b) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">{b.item}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">{b.priceSAR} ر.س</td>
                    <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">{b.purity}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
            * السعر الموضح هو تقدير مبني على سعر الشاشة اللحظي للذهب الخام. عند الشراء من المحلات، يتم إضافة "أجرة تصنيع" (مصنعية) بسيطة جداً للسبائك تختلف حسب الشركة المصنعة.
          </div>
        </section>

        <AdBanner />

        <!-- Image Placeholder for SEO -->
        <div class="w-full h-48 md:h-64 bg-gray-100 rounded-lg mb-4 border border-gray-200 flex items-center justify-center text-gray-400 text-sm overflow-hidden relative">
           <!-- المستقبلي: أضف صورة حقيقية هنا لسبائك ذهب مغلفة -->
           <img src="/images/saudi-gold-bullion.jpg" alt="سبائك الذهب عيار 24 في السعودية ماركة بامب والراجحي" class="w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-300" onload="this.classList.remove('opacity-0')" onerror="this.style.display='none'" />
           <span class="z-10">[مساحة لصورة توضيحية لسبائك الذهب عيار 24 وغلافها]</span>
        </div>

        <!-- AEO SEO Content Block (Ali Abdaal Style) -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-r-4 border-emerald-500 pr-3">دليل الاستثمار في السبائك بالسعودية</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>🛡️</span> الإعفاء الضريبي للسبائك
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                وفقاً لهيئة الزكاة والضريبة والجمارك في السعودية، فإن الذهب المخصص للاستثمار (الذي لا تقل نسبة نقائه عن <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-bold">99%</span> والقابل للتداول في الأسواق) يخضع لنسبة الصفر في ضريبة القيمة المضافة. هذا يشمل جميع سبائك عيار 24.
              </p>
            </div>
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>⚖️</span> أفضل أوزان السبائك للاستثمار
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                يُنصح المستثمرون بشراء سبائك بوزن <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">50 جرام إلى 100 جرام</span> (أو الأونصة 31.1 جرام). كلما زاد وزن السبيكة، انخفضت تكلفة مصنعيتها (أجرة السك) للجرام الواحد، مما يعظم من أرباحك عند البيع مقارنة بسبائك 1 جرام الصغيرة.
              </p>
            </div>
          </div>
        </section>

        <!-- New Thick Content: Weight Comparison -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-lg font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">مقارنة أوزان السبائك (المصنعية والسيولة)</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-right text-sm">
              <thead class="bg-gray-50 border-b border-gray-200 text-gray-700">
                <tr>
                  <th class="py-3 px-4">وزن السبيكة</th>
                  <th class="py-3 px-4">المصنعية للجرام</th>
                  <th class="py-3 px-4">سهولة التسييل (البيع)</th>
                  <th class="py-3 px-4">التقييم الاستثماري</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 text-gray-600">
                <tr>
                  <td class="py-3 px-4 font-bold text-gray-900">1 إلى 5 جرام</td>
                  <td class="py-3 px-4 text-red-600 font-medium">مرتفعة نسبياً</td>
                  <td class="py-3 px-4">سهلة جداً</td>
                  <td class="py-3 px-4">جيد للهدايا والادخار البسيط</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-gray-900">10 إلى 31.1 جرام (أونصة)</td>
                  <td class="py-3 px-4 text-amber-600 font-medium">متوسطة ومقبولة</td>
                  <td class="py-3 px-4">سهلة جداً</td>
                  <td class="py-3 px-4 font-bold text-emerald-700 bg-emerald-50">ممتاز للمستثمر المتوسط</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-gray-900">50 إلى 100 جرام</td>
                  <td class="py-3 px-4 text-emerald-600 font-medium">منخفضة وممتازة</td>
                  <td class="py-3 px-4">سهلة</td>
                  <td class="py-3 px-4 font-bold text-emerald-700 bg-emerald-50">الخيار الاحترافي الأفضل</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-gray-900">1 كيلو (1000 جرام)</td>
                  <td class="py-3 px-4 text-emerald-600 font-bold">الأقل على الإطلاق</td>
                  <td class="py-3 px-4 text-amber-700">تتطلب سيولة عالية من المشتري</td>
                  <td class="py-3 px-4">لكبار المستثمرين والمؤسسات</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Specific FAQ for Bullions -->
        <section class="mb-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">أسئلة شائعة حول سبائك وجنيهات الذهب</h2>
          <div class="space-y-4">
            {faqData.map((faq) => (
              <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
                <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                  <span>{faq.question}</span>
                  <span class="transition group-open:rotate-180 text-amber-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>

      </main>

      <!-- SIDEBAR COLUMN (4 Columns) -->
      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          
          <!-- Call to Action Widget -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3 text-lg">⚖️ احسب زكاة مدخراتك</h3>
             <a href="/zakat-calculator" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               استخدم حاسبة الزكاة الذكية
             </a>
          </div>

          <AdBanner variant="vertical" />

        </div>
      </aside>

    </div>
  </div>

  <script>
  async function fetchLiveBullionRates() {
    try {
      const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
      const data = await response.json();
      
      // Note: Time badge is now handled by the LiveTimeBadge component automatically.

      // Hydrate Bullion Specific Table
      const tbody = document.getElementById('bullion-table-body');
      if (tbody && data.rates && data.rates["24K"] && data.units) {
        const buy24k = parseFloat(data.rates["24K"].gram_buy);
        const pound21k = parseFloat(data.units.pound_21k_sar);
        const ounce = parseFloat(data.units.ounce_sar);
        const kilo = parseFloat(data.units.kilo_sar);

        tbody.innerHTML = `
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">سبيكة 1 جرام (عيار 24)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${(buy24k * 1).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">99.9%</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">سبيكة 5 جرام (عيار 24)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${(buy24k * 5).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">99.9%</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">سبيكة 10 جرام (عيار 24)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${(buy24k * 10).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">99.9%</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors bg-emerald-50/30">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">أونصة الذهب (31.1 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${ounce.toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">99.9%</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">سبيكة 50 جرام (عيار 24)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${(buy24k * 50).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">99.9%</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">سبيكة 100 جرام (عيار 24)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${(buy24k * 100).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">99.9%</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors bg-emerald-50/30">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">كيلو ذهب (1000 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${kilo.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">99.9%</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors border-t-2 border-gray-200">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">جنيه ذهب سعودي (8 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${pound21k.toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">عيار 21</td>
          </tr>
        `;
      }
    } catch (error) {
      console.error('Error fetching live bullion rates:', error);
    }
  }

  // Execute immediately
  fetchLiveBullionRates();
  </script>
</Layout>