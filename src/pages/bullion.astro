---
import Layout from '../layouts/Layout.astro';

const lastUpdated = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});

const bullions = [
  { item: 'جنيه الذهب السعودي (8 جرام عيار 21)', priceSAR: '2,208.80', tax: 'معفى من الضريبة' },
  { item: 'نصف جنيه ذهب (4 جرام عيار 21)', priceSAR: '1,104.40', tax: 'معفى من الضريبة' },
  { item: 'سبيكة ذهب 1 جرام (عيار 24)', priceSAR: '347.00', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 5 جرام (عيار 24)', priceSAR: '1,640.60', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 10 جرام (عيار 24)', priceSAR: '3,218.10', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 20 جرام (عيار 24)', priceSAR: '6,436.20', tax: 'معفى (نقاء 99%)' },
  { item: 'أونصة الذهب (31.1 جرام عيار 24)', priceSAR: '10,012.00', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 50 جرام (عيار 24)', priceSAR: '15,853.00', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 100 جرام (عيار 24)', priceSAR: '31,644.00', tax: 'معفى (نقاء 99%)' },
  { item: 'كيلو ذهب (1000 جرام عيار 24)', priceSAR: '315,500.00', tax: 'معفى (نقاء 99%)' }
];
---

<Layout 
  title="أسعار سبائك الذهب والجنيهات في السعودية اليوم | تحديث مباشر"
  description="تعرف على أسعار سبائك الذهب عيار 24 والجنيهات الذهبية عيار 21 في السعودية اليوم. تحديث لحظي لأسعار الأونصة، الكيلو، والجرامات المعفاة من الضريبة."
>
  <nav class="max-w-7xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 space-x-reverse">
      <li><a href="/" class="hover:text-gold-700 font-medium">الرئيسية</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-gold-700 font-semibold">أسعار سبائك الذهب</li>
    </ol>
  </nav>

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
       تحديث فوري من بورصة المعادن: بتوقيت الرياض (<span class="live-timestamp">{lastUpdated}</span>)
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        أسعار سبائك الذهب والجنيهات الاستثمارية في السعودية
      </h1>
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed">
        جدول التسعير المباشر لسبائك الذهب الصافي (عيار 24 بنقاء 999.9) والجنيهات الذهبية. هذه الأوزان تعتبر الخيار الأمثل للاستثمار وحفظ الثروة لكونها معفاة من ضريبة القيمة المضافة.
      </p>
    </header>

    <!-- The 12-Column Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN CONTENT (8 Columns) -->
      <main class="lg:col-span-8 space-y-10">
        
        <!-- AdSense Top Banner Placeholder -->
        <div class="w-full min-h-[90px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          <!-- Google AdSense Code will inject here -->
          [مساحة إعلانية أفقية]
        </div>

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex justify-between items-center">
            <h2 class="font-bold text-base md:text-lg text-gray-800">أسعار السبائك والجنيهات المباشرة</h2>
            <span class="text-xs text-gold-700 font-bold">بدون مصنعية التاجر</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4">الوزن / الصنف</th>
                  <th class="py-3 px-4">السعر التقديري (SAR)</th>
                  <th class="py-3 px-4">الضريبة (VAT)</th>
                </tr>
              </thead>
              <tbody id="bullion-table-body" class="divide-y divide-gray-200 text-sm">
                {bullions.map((b) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900">{b.item}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">{b.priceSAR} ر.س</td>
                    <td class="py-3.5 px-4 text-gray-600 text-xs">{b.tax}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
            * السعر الظاهر يمثل قيمة الذهب الخام الخالص. تضاف عمولة بسيطة (مصنعية التاجر) عند الشراء الفعلي من المحل وتختلف من شركة لأخرى (مثل بامب، سويس، أو الراجحي).
          </div>
        </section>

        <!-- AdSense Middle Content Placeholder -->
        <div class="w-full min-h-[250px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          <!-- Google AdSense Square/Responsive Code will inject here -->
          [مساحة إعلانية داخل المحتوى]
        </div>

        <!-- Educational & AEO Content Block -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-lg text-gray-900 mb-2">لماذا السبائك هي الأفضل للاستثمار؟</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              تُصنع السبائك من الذهب الخالص عيار 24 بنسبة نقاء 999.9. تتميز بأن تكلفة مصنعيتها شبه معدومة مقارنة بالمشغولات، مما يعني أنك لا تخسر الكثير من قيمتها عند إعادة البيع.
            </p>
          </article>

          <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-lg text-gray-900 mb-2">نظام الإعفاء الضريبي في السعودية</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              وفقاً لهيئة الزكاة والضريبة والجمارك، يُعفى الذهب المخصص للاستثمار (الذي لا تقل نسبة نقائه عن 99%) من ضريبة القيمة المضافة. تُدفع الضريبة (15%) فقط على "عمولة التاجر" وليس على قيمة الذهب نفسه.
            </p>
          </article>
        </section>

        <!-- FAQ Accordion Block (Expanded for AEO) -->
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">الأسئلة الشائعة حول سبائك الذهب</h2>
          <div class="space-y-4">
            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>أيهما أفضل للاستثمار: الجنيه الذهب أم السبيكة؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                السبائك (عيار 24) هي الأفضل نقاءً واستثماراً على المدى الطويل ومعفاة من الضريبة. الجنيه الذهب (عيار 21 أو 22) ممتاز أيضاً لسهولة تسييله وبيعه محلياً، ومصنعيته منخفضة جداً. الخيار يعتمد على ميزانيتك.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>هل يمكن بيع السبيكة بسهولة في أي محل؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                نعم، السبائك المغلفة والمختومة (خصوصاً من الشركات المعتمدة) تُشترى وتباع بسهولة بالغة في جميع محلات الصاغة في السعودية بناءً على السعر العالمي اللحظي. تأكد فقط من الاحتفاظ بالفاتورة وغلاف السبيكة.
              </p>
            </details>
          </div>
        </section>

      </main>

      <!-- SIDEBAR COLUMN (4 Columns - Sticky AdSense Placement) -->
      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          
          <!-- Call to Action Widget -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3">حساب الشراء للمشغولات؟</h3>
             <a href="/" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               العودة لأسعار الجرام عيار 21
             </a>
          </div>

          <!-- Vertical AdSense Placeholder -->
          <div class="w-full h-[600px] bg-gray-50 border border-gray-200 flex flex-col items-center justify-center rounded-xl text-gray-500 text-sm">
             <span class="mb-2 text-2xl">🪙</span>
             <span>[مساحة إعلانية عمودية]</span>
             <span class="text-xs mt-1 text-gray-300">SkyScraper Ad (300x600)</span>
          </div>

        </div>
      </aside>

    </div>
  </div>

  <script>
    async function fetchBullionRates() {
      try {
        const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
        const data = await response.json();
        
        // 1. Calculate the exact current Riyadh time dynamically in the browser
const saudiTime = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});

const timeElements = document.querySelectorAll('.live-timestamp');
timeElements.forEach(el => el.textContent = saudiTime);

        // Update Bullion Table
        const bullionBody = document.getElementById('bullion-table-body');
        if (bullionBody && data.rates["24K"] && data.units) {
          const g24 = parseFloat(data.rates["24K"].gram_buy);
          const pound = parseFloat(data.units.pound_21k_sar);
          const ounce = parseFloat(data.units.ounce_sar);
          
          bullionBody.innerHTML = `
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">جنيه الذهب السعودي (8 جرام عيار 21)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${pound.toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى من الضريبة</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">نصف جنيه ذهب (4 جرام عيار 21)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${(pound / 2).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى من الضريبة</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 1 جرام (عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${(g24 * 1).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 5 جرام (عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${(g24 * 5).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 10 جرام (عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${(g24 * 10).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 20 جرام (عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${(g24 * 20).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors bg-amber-50"><td class="py-3.5 px-4 font-bold text-gray-900">أونصة الذهب (31.1 جرام عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-extrabold text-lg">${ounce.toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 50 جرام (عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${(g24 * 50).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 100 جرام (عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${(g24 * 100).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
            <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">كيلو ذهب (1000 جرام عيار 24)</td><td class="py-3.5 px-4 text-emerald-700 font-bold text-lg">${data.units.kilo_sar} ر.س</td><td class="py-3.5 px-4 text-gray-500 text-xs">معفى (نقاء 99%)</td></tr>
          `;
        }
      } catch (error) {
        console.error('Error fetching bullion rates:', error);
      }
    }
    fetchBullionRates();
  </script>
</Layout>