---
import Layout from '../layouts/Layout.astro';

// SEO & UI Components
import Breadcrumb from '../components/Breadcrumb.astro';
import LiveTimeBadge from '../components/LiveTimeBadge.astro';
import AdBanner from '../components/AdBanner.astro';

// AEO-Optimized FAQ Data (For JSON-LD Schema)
const faqData = [
  {
    question: "ما الفرق بين ذهب عيار 21 و عيار 22؟",
    answer: "الفرق يكمن في نسبة النقاء. عيار 22 يحتوي على 91.6% من الذهب الخالص وهو أنقى وأغلى، بينما عيار 21 يحتوي على 87.5%. عيار 22 يكون أصفر فاقعاً ولكنه أقل صلابة وقابل للخدش أسرع من عيار 21."
  },
  {
    question: "هل الذهب الهندي في السعودية يكون عيار 22؟",
    answer: "نعم، معظم الذهب بالتصاميم الهندية والتراثية الخليجية المتوفرة في أسواق السعودية تُصاغ من عيار 22 (الذي يُختم برقم 916) نظراً للونه الغني وقيمته العالية."
  },
  {
    question: "هل الاستثمار في عيار 22 مربح؟",
    answer: "يعد عيار 22 ممتازاً لحفظ الثروة لارتفاع نسبة الذهب فيه، ولكنه أقل كفاءة من السبائك (عيار 24) لأنك تدفع قيمة مصنعية وضريبة عند شراء مشغولات عيار 22 ولن تستردها عند البيع."
  }
];

// Fallback static data specifically for 22K
const rates22k = [
  { weight: '1 جرام عيار 22', buySAR: '289.20', sellSAR: '286.00' },
  { weight: '5 جرام عيار 22', buySAR: '1,446.00', sellSAR: '1,430.00' },
  { weight: '10 جرام عيار 22', buySAR: '2,892.00', sellSAR: '2,860.00' },
  { weight: 'تولة عيار 22 (11.66 جرام)', buySAR: '3,372.07', sellSAR: '3,334.76' },
  { weight: 'أونصة عيار 22 (31.1 جرام)', buySAR: '8,994.12', sellSAR: '8,894.60' }
];
---

<Layout 
  title="سعر الذهب عيار 22 اليوم في السعودية | الذهب الخليجي والهندي"
  description="تابع سعر جرام الذهب عيار 22 اليوم في السعودية. جدول أسعار محدث لحظياً لذهب 22 (عيار 916) المفضل للمشغولات الخليجية والهندية."
  faq={faqData}
>
  <Breadcrumb currentPage="سعر الذهب عيار 22" />

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      
      <LiveTimeBadge text="تحديث فوري 🇸🇦 لعيار 22:" />

      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
        سعر الذهب عيار 22 اليوم في السعودية
      </h1>
      
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed mb-3">
        عيار 22 (ويعرف بدمغة <span class="font-bold text-gray-800">916</span>) يتميز بنقائه العالي ولونه الأصفر الغني، وهو <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-medium">الخيار الأول للمشغولات التراثية، الخليجية، والهندية الثقيلة</span>. تابع تسعيرة السوق المباشرة للجرام والأوزان المختلفة <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">محدثة لحظياً</span>.
      </p>

      <p class="text-xs text-gray-500 flex items-center gap-1">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>بيانات مستمدة برمجياً من الشاشة العالمية (Spot Market) وفق أحدث المعايير.</span>
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <main class="lg:col-span-8 space-y-10">
        
        <AdBanner />

        <!-- 22K Rates Table -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-4 md:px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex flex-wrap justify-between items-center gap-2">
            <h2 class="font-bold text-base md:text-lg text-gray-800 flex items-center gap-2">
              <span>✨</span> جدول أسعار عيار 22 (بدون مصنعية)
            </h2>
            <span class="text-xs font-semibold text-amber-900 bg-amber-100 px-2 py-1 rounded shadow-sm">العملة: ريال سعودي</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[500px]">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4 whitespace-nowrap">الوزن والصنف</th>
                  <th class="py-3 px-4 whitespace-nowrap">سعر الشراء (جديد خام)</th>
                  <th class="py-3 px-4 whitespace-nowrap">سعر البيع (كسر مستعمل)</th>
                </tr>
              </thead>
              <tbody id="rates22k-table-body" class="divide-y divide-gray-200 text-sm">
                {rates22k.map((row) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">{row.weight}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">{row.buySAR} ر.س</td>
                    <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">{row.sellSAR} ر.س</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
            * السعر الموضح أعلاه هو سعر الذهب الخام فقط. عيار 22 يتطلب مصنعية عالية نظراً لدقة المشغولات الهندية والتراثية، وتضاف ضريبة 15% على إجمالي الشراء.
          </div>
        </section>

        <!-- Thick Content -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-r-4 border-amber-500 pr-3">مواصفات واستخدامات ذهب عيار 22</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>🌟</span> نقاء مرتفع (دمغة 916)
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                يحتوي عيار 22 على <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">91.6% ذهب خالص</span>، وهو ما يفسر دمغته الشهيرة برقم (916). الـ 8.4% المتبقية هي مزيج من معادن أخرى تعطيه تماسكاً يسمح بتشكيله كمجوهرات.
              </p>
            </div>
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>💍</span> تصميمات ثقيلة ولا أحجار
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                نظراً لليونته النسبية (مقارنة بعيار 21 و 18)، نادراً ما يُرصع عيار 22 بالأحجار الكريمة الثقيلة أو الألماس لأنه قد ينثني ويفقد الحجر. لذلك نجده غالباً في <span class="font-bold">المشغولات الذهبية الخالصة الثقيلة (المصمتة)</span> مثل الغوايش والأطقم الهندية والسبائك المشغولة.
              </p>
            </div>
          </div>
        </section>

        <AdBanner />

        <!-- FAQs -->
        <section class="mb-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">الأسئلة الشائعة حول الذهب الخليجي عيار 22</h2>
          <div class="space-y-4">
            {faqData.map((faq) => (
              <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
                <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                  <span>{faq.question}</span>
                  <span class="transition group-open:rotate-180 text-amber-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>

      </main>

      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3 text-lg">⚖️ هل بلغ ذهبك النصاب؟</h3>
             <a href="/zakat-calculator" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               استخدم حاسبة الزكاة مجاناً
             </a>
          </div>
          <AdBanner variant="vertical" />
        </div>
      </aside>

    </div>
  </div>

  <script>
  async function fetchLive22KRates() {
    try {
      const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
      const data = await response.json();

      const tbody = document.getElementById('rates22k-table-body');
      if (tbody && data.rates && data.rates["22K"]) {
        const buy22k = parseFloat(data.rates["22K"].gram_buy);
        const sell22k = parseFloat(data.rates["22K"].gram_sell);

        tbody.innerHTML = `
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">1 جرام عيار 22</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${buy22k.toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${sell22k.toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">5 جرام عيار 22</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy22k * 5).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell22k * 5).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">10 جرام عيار 22</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy22k * 10).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell22k * 10).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">تولة عيار 22 (11.66 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy22k * 11.66).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell22k * 11.66).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors bg-amber-50/30">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">أونصة عيار 22 (31.1 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${(buy22k * 31.1).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-bold whitespace-nowrap">${(sell22k * 31.1).toFixed(2)} ر.س</td>
          </tr>
        `;
      }
    } catch (error) {
      console.error('Error fetching live gold rates:', error);
    }
  }

  fetchLive22KRates();
  </script>
</Layout>