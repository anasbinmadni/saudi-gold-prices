---
import Layout from '../layouts/Layout.astro';

// Naye SEO & UI Components
import Breadcrumb from '../components/Breadcrumb.astro';
import LiveTimeBadge from '../components/LiveTimeBadge.astro';
import AdBanner from '../components/AdBanner.astro';

// AEO-Optimized FAQ Data (Will be passed to Layout for JSON-LD Schema)
const faqData = [
  {
    question: "هل يخصم المحل ضريبة القيمة المضافة عند بيعي للذهب؟",
    answer: "لا، بيع المستهلك (الفرد) للذهب المستعمل إلى المحلات التجارية يُعد خارج نطاق ضريبة القيمة المضافة. يجب أن تستلم قيمة وزن الذهب مضروباً في سعر الشاشة الصافي دون أي استقطاعات ضريبية."
  },
  {
    question: "هل أحتاج فاتورة الشراء القديمة لبيع الذهب؟",
    answer: "نعم، يُنصح بشدة إحضار الفاتورة الأصلية. الفاتورة تُثبت ملكيتك للقطعة وتحميك، كما أنها توضح وزن الذهب الصافي ووزن الفصوص، مما يمنع التاجر من المبالغة في خصم الأوزان."
  },
  {
    question: "متى يكون أفضل وقت لبيع الذهب المستعمل؟",
    answer: "أفضل وقت للبيع هو عند تسجيل سعر أونصة الذهب مستويات قياسية مرتفعة بالدولار عالمياً. بما أن الريال السعودي مربوط بالدولار، فإن أي ارتفاع عالمي ينعكس فوراً على سعر الجرام الذي سيشتريه منك التاجر."
  }
];

// Fallback static data for Used Gold (Scrap)
const usedGoldRates = [
  { carat: 'عيار 24 (سبائك صافية)', priceSAR: '315.50', note: 'أعلى قيمة استرداد' },
  { carat: 'عيار 22 (ذهب خليجي)', priceSAR: '289.20', note: 'تُخصم المصنعية فقط' },
  { carat: 'عيار 21 (حلي وجنيهات)', priceSAR: '276.10', note: 'الأكثر مبيعاً بالأسواق' },
  { carat: 'عيار 18 (مجوهرات بفصوص)', priceSAR: '236.60', note: 'يُخصم وزن الفصوص والزيركون' }
];
---

<Layout 
  title="سعر بيع الذهب المستعمل اليوم في السعودية | كسر الذهب"
  description="تعرف على أسعار بيع الذهب المستعمل (الكسر) لمحلات الصاغة في السعودية اليوم. جدول محدث لحظياً لعيار 21 و 18 و 24 مع نصائح لتجنب الخسارة عند البيع."
  faq={faqData}
>
  <Breadcrumb currentPage="سعر بيع الذهب المستعمل" />

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      
      <LiveTimeBadge text="تحديث فوري 🇸🇦 لسعر الكسر:" />

      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
        سعر بيع الذهب المستعمل (الكسر) لمحلات الصاغة
      </h1>
      
      <!-- Ali Abdaal Style Highlights -->
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed mb-3">
        عند رغبتك في بيع ذهبك القديم للمحل، يتم حساب السعر بناءً على <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-medium">الوزن الصافي للذهب (بدون فصوص)</span> مضروباً في سعر الشراء اللحظي للشاشة العالمية. بيع الذهب المستعمل للأفراد <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">لا يخضع لضريبة القيمة المضافة (VAT)</span>.
      </p>

      <!-- Source Citation (E-E-A-T) -->
      <p class="text-xs text-gray-500 flex items-center gap-1">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>بيانات أسعار الاسترداد تعتمد حصرياً على الشاشة العالمية (Global Spot Price).</span>
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN CONTENT (8 Columns) -->
      <main class="lg:col-span-8 space-y-10">
        
        <AdBanner />

        <!-- Used Gold Live Rates Table -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-4 md:px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex flex-wrap justify-between items-center gap-2">
            <h2 class="font-bold text-base md:text-lg text-gray-800 flex items-center gap-2">
              <span>♻️</span> أسعار شراء المحلات للذهب المستعمل
            </h2>
            <span class="text-xs font-semibold text-amber-900 bg-amber-100 px-2 py-1 rounded shadow-sm">العملة: ريال سعودي</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[500px]">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4 whitespace-nowrap">العيار</th>
                  <th class="py-3 px-4 whitespace-nowrap">السعر الذي يقبضه الزبون (لجرام الصافي)</th>
                  <th class="py-3 px-4 whitespace-nowrap">ملاحظات عند البيع</th>
                </tr>
              </thead>
              <tbody id="used-gold-table-body" class="divide-y divide-gray-200 text-sm">
                {usedGoldRates.map((row) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">{row.carat}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap text-base">{row.priceSAR} ر.س</td>
                    <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
            * تنبيه: السعر أعلاه يمثل قيمة الذهب الصافي فقط (سعر الشاشة). تفقد المشغولات الذهبية قيمة "المصنعية" (أجرة الصياغة) التي دُفعت عند شرائها جديدة، حيث يشتري التاجر الذهب كخام لصهرِهِ مجدداً.
          </div>
        </section>

        <AdBanner />

        <!-- Image Placeholder for SEO -->
        <div class="w-full h-48 md:h-64 bg-gray-100 rounded-lg mb-4 border border-gray-200 flex items-center justify-center text-gray-400 text-sm overflow-hidden relative">
           <!-- المستقبلي: أضف صورة حقيقية هنا لميزان الذهب وقطع ذهب مستعملة -->
           <img src="/images/saudi-scrap-gold-scale.jpg" alt="وزن وبيع الذهب المستعمل والكسر في محلات السعودية" class="w-full h-full object-cover absolute inset-0 opacity-0 transition-opacity duration-300" onload="this.classList.remove('opacity-0')" onerror="this.style.display='none'" />
           <span class="z-10">[مساحة لصورة توضيحية لميزان الذهب أو كسر الذهب]</span>
        </div>

        <!-- AEO SEO Content Block (Ali Abdaal Style) -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-r-4 border-amber-500 pr-3">دليل بيع الذهب المستعمل بدون خسارة</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>📉</span> خسارة المصنعية أمر حتمي
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                عند شرائك للذهب الجديد، فإنك تدفع ثمن (الذهب الخام + أجرة وتعب الصائغ). أما عند البيع، فإن الصائغ يشتري منك <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">الذهب الخام فقط</span> تمهيداً لصهره وإعادة تشكيله. لذلك لا يتم تعويضك أبداً عن قيمة المصنعية القديمة.
              </p>
            </div>
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>💎</span> مشكلة الفصوص والأحجار
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                معظم محلات الذهب في السعودية ستقوم بفك الفصوص والأحجار الكريمة (الزيركون أو الكريستال) من المشغولات قبل وزنها، أو <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">خصم وزنها التقديري</span>. يُنصح بشراء الذهب الصافي (بدون فصوص) أساساً إذا كان الغرض هو الاستثمار والبيع لاحقاً.
              </p>
            </div>
          </div>
        </section>

        <!-- New Thick Content: Practical Steps -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-lg font-bold text-gray-900 mb-4 border-r-4 border-emerald-500 pr-3">خطوات عملية قبل الذهاب لبيع ذهبك المستعمل</h2>
          <ol class="space-y-4 text-sm text-gray-600 list-decimal list-inside">
            <li class="leading-relaxed"><strong class="text-gray-900">افرز الأعيرة:</strong> قم بفصل المشغولات حسب العيار (عيار 18 وحده، وعيار 21 وحده) حتى لا يتم حساب المجموع كله على العيار الأقل بالخطأ.</li>
            <li class="leading-relaxed"><strong class="text-gray-900">اعرف الوزن الصافي:</strong> حاول وزن الذهب في المنزل بميزان دقيق (أو ميزان مطبخ حساس) ليكون لديك تصور مبدئي عن الوزن الصافي بعد استبعاد الأحجار والفصوص.</li>
            <li class="leading-relaxed"><strong class="text-gray-900">تحقق من سعر الشاشة قبل الدخول للمحل:</strong> افتح هذه الصفحة داخل المحل، وتأكد أن التاجر يشتري منك بسعر الجرام المحدث الموضح في الجدول أعلاه وليس بسعر أقل بكثير.</li>
            <li class="leading-relaxed"><strong class="text-gray-900">تجنب أوقات تذبذب السوق العنيف:</strong> في أوقات الأخبار الاقتصادية الكبرى، قد يوقف التجار الشراء أو يعرضون سعراً أقل لحماية أنفسهم من تقلبات الأسعار.</li>
          </ol>
        </section>

        <!-- Specific FAQ for Used Gold -->
        <section class="mb-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">أسئلة وإجابات حول بيع الذهب المستعمل</h2>
          <div class="space-y-4">
            {faqData.map((faq) => (
              <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
                <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                  <span>{faq.question}</span>
                  <span class="transition group-open:rotate-180 text-amber-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>

      </main>

      <!-- SIDEBAR COLUMN (4 Columns) -->
      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          
          <!-- CTA to Zakat -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3 text-lg">🧾 قبل البيع</h3>
             <a href="/zakat-calculator" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               تأكد من إخراج زكاة ذهبك
             </a>
          </div>

          <AdBanner variant="vertical" />

        </div>
      </aside>

    </div>
  </div>

  <script>
  async function fetchLiveUsedGoldRates() {
    try {
      const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
      const data = await response.json();
      
      // Note: Time badge is now handled by the LiveTimeBadge component automatically.

      // Hydrate Used Gold Specific Table (We use 'gram_buy' which is the price shop buys AT)
      const tbody = document.getElementById('used-gold-table-body');
      if (tbody && data.rates) {
        // Map notes specifically for each carat
        const notes = {
          "24K": "أعلى قيمة استرداد",
          "22K": "تُخصم المصنعية فقط",
          "21K": "الأكثر مبيعاً بالأسواق",
          "18K": "يُخصم وزن الفصوص والزيركون"
        };
        
        const labels = {
          "24K": "عيار 24 (سبائك صافية)",
          "22K": "عيار 22 (ذهب خليجي)",
          "21K": "عيار 21 (حلي وجنيهات)",
          "18K": "عيار 18 (مجوهرات بفصوص)"
        };

        // Filter and map only the main carats
        const rowsHTML = ["24K", "22K", "21K", "18K"].map(caratKey => {
          if (data.rates[caratKey]) {
            const price = parseFloat(data.rates[caratKey].gram_buy);
            return `
              <tr class="hover:bg-amber-50/40 transition-colors">
                <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">${labels[caratKey]}</td>
                <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap text-base">${price.toFixed(2)} ر.س</td>
                <td class="py-3.5 px-4 text-gray-600 font-medium whitespace-nowrap">${notes[caratKey]}</td>
              </tr>
            `;
          }
          return '';
        }).join('');
        
        tbody.innerHTML = rowsHTML;
      }
    } catch (error) {
      console.error('Error fetching live used gold rates:', error);
    }
  }

  // Execute immediately
  fetchLiveUsedGoldRates();
  </script>
</Layout>