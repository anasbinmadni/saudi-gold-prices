---
import Layout from '../layouts/Layout.astro';

// SEO & UI Components
import Breadcrumb from '../components/Breadcrumb.astro';
import LiveTimeBadge from '../components/LiveTimeBadge.astro';
import AdBanner from '../components/AdBanner.astro';

// AEO-Optimized FAQ Data (For JSON-LD Schema)
const faqData = [
  {
    question: "لماذا يُستخدم عيار 18 في مجوهرات الألماس؟",
    answer: "عيار 18 يحتوي على 75% ذهب و25% معادن أخرى تكسبه صلابة استثنائية، مما يجعله آمناً جداً لتثبيت الأحجار الكريمة والألماس دون خوف من سقوطها أو التواء القطعة."
  },
  {
    question: "هل ذهب عيار 18 جيد للاستثمار؟",
    answer: "لا يُنصح بعيار 18 للاستثمار لأن مصنعيته (أجرة الصياغة) تكون مرتفعة جداً بسبب تعقيد تصاميمه، مما يعني خسارة جزء كبير من قيمته عند الرغبة في إعادة بيعه."
  },
  {
    question: "كيف أحسب سعر الذهب عيار 18 عند الشراء؟",
    answer: "سعر الشراء الإجمالي = (وزن القطعة × سعر جرام 18 اللحظي) + مصنعية الصائغ + 15% ضريبة القيمة المضافة المحسوبة على إجمالي الفاتورة."
  }
];

// Fallback static data specifically for 18K
const rates18k = [
  { weight: '1 جرام عيار 18', buySAR: '236.60', sellSAR: '234.10' },
  { weight: '5 جرام عيار 18', buySAR: '1,183.00', sellSAR: '1,170.50' },
  { weight: '10 جرام عيار 18', buySAR: '2,366.00', sellSAR: '2,341.00' },
  { weight: 'تولة عيار 18 (11.66 جرام)', buySAR: '2,758.75', sellSAR: '2,729.60' },
  { weight: 'أونصة عيار 18 (31.1 جرام)', buySAR: '7,358.26', sellSAR: '7,280.51' }
];
---

<Layout 
  title="سعر الذهب عيار 18 اليوم في السعودية | المشغولات العصرية"
  description="تابع سعر جرام الذهب عيار 18 اليوم في السعودية بيع وشراء. جدول محدث لحظياً لأسعار الذهب عيار 18 المفضل للمجوهرات والألماس."
  faq={faqData}
>
  <Breadcrumb currentPage="سعر الذهب عيار 18" />

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      
      <LiveTimeBadge text="تحديث فوري 🇸🇦 لعيار 18:" />

      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
        سعر الذهب عيار 18 اليوم في السعودية بيع وشراء
      </h1>
      
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed mb-3">
        عيار 18 هو <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-medium">العيار المفضل للمشغولات العصرية</span> والمجوهرات المرصعة بالألماس في السعودية، نظراً لصلابته العالية التي تسمح بتصاميم دقيقة. تجد هنا أسعار الجرام المباشرة للبيع والشراء <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">محدثة لحظياً</span>.
      </p>

      <p class="text-xs text-gray-500 flex items-center gap-1">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>بيانات مستمدة برمجياً من الشاشة العالمية (Spot Market) وفق أحدث المعايير.</span>
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <main class="lg:col-span-8 space-y-10">
        
        <AdBanner />

        <!-- 18K Rates Table -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-4 md:px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex flex-wrap justify-between items-center gap-2">
            <h2 class="font-bold text-base md:text-lg text-gray-800 flex items-center gap-2">
              <span>💎</span> جدول أسعار عيار 18 (بدون مصنعية)
            </h2>
            <span class="text-xs font-semibold text-amber-900 bg-amber-100 px-2 py-1 rounded shadow-sm">العملة: ريال سعودي</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[500px]">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4 whitespace-nowrap">الوزن والصنف</th>
                  <th class="py-3 px-4 whitespace-nowrap">سعر الشراء (جديد خام)</th>
                  <th class="py-3 px-4 whitespace-nowrap">سعر البيع (كسر مستعمل)</th>
                </tr>
              </thead>
              <tbody id="rates18k-table-body" class="divide-y divide-gray-200 text-sm">
                {rates18k.map((row) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">{row.weight}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">{row.buySAR} ر.س</td>
                    <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">{row.sellSAR} ر.س</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
            * السعر الموضح أعلاه هو سعر الذهب الخام فقط (75% ذهب). عند شراء مشغولات عيار 18، يضاف إليها قيمة "المصنعية" المرتفعة نسبياً بالإضافة إلى الضريبة.
          </div>
        </section>

        <!-- Thick Content -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-r-4 border-amber-500 pr-3">مميزات ذهب عيار 18 (عيار 750)</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>🔗</span> متانة وصلابة استثنائية
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                يتكون عيار 18 من <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">75% ذهب خالص</span> و 25% من معادن أخرى (مثل النحاس والفضة والزنك). هذه التركيبة تمنحه صلابة قوية تجعله مقاوماً للخدش والانثناء، وهو السبب الرئيسي لاستخدامه في المجوهرات اليومية والأطقم المرصعة بالفصوص.
              </p>
            </div>
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>🎨</span> ألوان متعددة (الذهب الأبيض والوردي)
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                بفضل نسبة الـ 25% المتبقية، يمكن لشركات المجوهرات (مثل لازوردي وغيرها) تغيير لون الذهب بسهولة. فإضافة البلاديوم تصنع <span class="font-bold">الذهب الأبيض</span>، وإضافة المزيد من النحاس تصنع <span class="font-bold">الذهب الوردي (Rose Gold)</span>، وكلاهما يكون عيار 18.
              </p>
            </div>
          </div>
        </section>

        <AdBanner />

        <!-- FAQs -->
        <section class="mb-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">أسئلة شائعة حول عيار 18</h2>
          <div class="space-y-4">
            {faqData.map((faq) => (
              <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
                <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                  <span>{faq.question}</span>
                  <span class="transition group-open:rotate-180 text-amber-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>

      </main>

      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3 text-lg">⚖️ هل بلغ ذهبك النصاب؟</h3>
             <a href="/zakat-calculator" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               استخدم حاسبة الزكاة مجاناً
             </a>
          </div>
          <AdBanner variant="vertical" />
        </div>
      </aside>

    </div>
  </div>

  <script>
  async function fetchLive18KRates() {
    try {
      const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
      const data = await response.json();

      const tbody = document.getElementById('rates18k-table-body');
      if (tbody && data.rates && data.rates["18K"]) {
        const buy18k = parseFloat(data.rates["18K"].gram_buy);
        const sell18k = parseFloat(data.rates["18K"].gram_sell);

        tbody.innerHTML = `
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">1 جرام عيار 18</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${buy18k.toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${sell18k.toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">5 جرام عيار 18</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy18k * 5).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell18k * 5).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">10 جرام عيار 18</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy18k * 10).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell18k * 10).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">تولة عيار 18 (11.66 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy18k * 11.66).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell18k * 11.66).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors bg-amber-50/30">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">أونصة عيار 18 (31.1 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${(buy18k * 31.1).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-bold whitespace-nowrap">${(sell18k * 31.1).toFixed(2)} ر.س</td>
          </tr>
        `;
      }
    } catch (error) {
      console.error('Error fetching live gold rates:', error);
    }
  }

  fetchLive18KRates();
  </script>
</Layout>