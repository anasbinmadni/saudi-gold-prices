---
import Layout from '../layouts/Layout.astro';

const lastUpdated = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});

// Fallback static data specifically for 21K
const rates21k = [
  { weight: '1 جرام عيار 21', buySAR: '276.10', sellSAR: '273.20' },
  { weight: '5 جرام عيار 21', buySAR: '1,380.50', sellSAR: '1,366.00' },
  { weight: '10 جرام عيار 21', buySAR: '2,761.00', sellSAR: '2,732.00' },
  { weight: 'تولة عيار 21 (11.66 جرام)', buySAR: '3,219.32', sellSAR: '3,185.51' },
  { weight: 'جنيه ذهب سعودي (8 جرام)', buySAR: '2,208.80', sellSAR: '2,185.60' }
];
---

<Layout 
  title="سعر الذهب عيار 21 اليوم في السعودية | تحديث مباشر"
  description="تابع سعر جرام الذهب عيار 21 اليوم في السعودية بيع وشراء. جدول محدث لحظياً لأسعار الذهب عيار 21 للمشغولات والجنيهات الذهبية بدون مصنعية."
>
  <nav class="max-w-7xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 space-x-reverse">
      <li><a href="/" class="hover:text-amber-600 font-medium transition">الرئيسية</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-amber-700 font-semibold" aria-current="page">سعر الذهب عيار 21</li>
    </ol>
  </nav>

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      
      <!-- Modern Pill Badge for Live Status -->
      <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs md:text-sm font-semibold mb-4 shadow-sm">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span>تحديث فوري 🇸🇦 لعيار 21:</span>
        <span class="live-timestamp bg-white px-2 py-0.5 rounded text-emerald-900 shadow-sm border border-emerald-100 whitespace-nowrap" dir="ltr">{lastUpdated}</span>
      </div>

      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
        سعر الذهب عيار 21 اليوم في السعودية بيع وشراء
      </h1>
      
      <!-- Ali Abdaal Style Highlights -->
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed">
        عيار 21 هو <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-medium">العيار الأكثر شعبية وتداولاً</span> في المملكة العربية السعودية لتميزه بالصلابة واللون الأصفر الغني. تجد هنا الأسعار المباشرة للجرام، والجنيه الذهبي، والأوزان المختلفة <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">محدثة لحظياً</span> من الشاشة العالمية.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN CONTENT (8 Columns) -->
      <main class="lg:col-span-8 space-y-10">
        
        <!-- AdSense Top Banner Placeholder -->
        <div class="w-full min-h-[90px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          [مساحة إعلانية]
        </div>

        <!-- 21K Specific Live Rates Table -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-4 md:px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex flex-wrap justify-between items-center gap-2">
            <h2 class="font-bold text-base md:text-lg text-gray-800 flex items-center gap-2">
              <span>✨</span> جدول أسعار عيار 21 (بدون مصنعية)
            </h2>
            <span class="text-xs font-semibold text-amber-900 bg-amber-100 px-2 py-1 rounded shadow-sm">العملة: ريال سعودي</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse min-w-[500px]">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4 whitespace-nowrap">الوزن والصنف</th>
                  <th class="py-3 px-4 whitespace-nowrap">سعر الشراء (جديد)</th>
                  <th class="py-3 px-4 whitespace-nowrap">سعر البيع (مستعمل)</th>
                </tr>
              </thead>
              <tbody id="rates21k-table-body" class="divide-y divide-gray-200 text-sm">
                {rates21k.map((row) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">{row.weight}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">{row.buySAR} ر.س</td>
                    <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">{row.sellSAR} ر.س</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
            * السعر الموضح أعلاه هو سعر الذهب الخام فقط. عند شراء مشغولات عيار 21، يضيف التاجر "المصنعية" وضريبة القيمة المضافة 15% على إجمالي الفاتورة.
          </div>
        </section>

        <!-- AdSense Middle Content Placeholder -->
        <div class="w-full min-h-[250px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          [مساحة إعلانية أفقية داخل المحتوى]
        </div>

        <!-- AEO SEO Content Block (Ali Abdaal Style) -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-r-4 border-amber-500 pr-3">لماذا عيار 21 هو الخيار الأول في السعودية؟</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>💰</span> استثمار وحفظ للثروة
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                يحتوي عيار 21 على نسبة <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">87.5% من الذهب الخالص</span>. هذا يجعله يحتفظ بقيمته بشكل ممتاز عند الرغبة في إعادة البيع (الكسر)، كما أن تكلفة مصنعيته أقل نسبياً مقارنة بعيار 18.
              </p>
            </div>
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>🛡️</span> المتانة واللون التراثي
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                يُضاف إليه نسبة 12.5% من النحاس والفضة، مما يمنحه <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">صلابة مثالية</span> للارتداء اليومي وصياغة الأطقم الكبيرة، مع الاحتفاظ باللون الأصفر الزاهي المفضل في الثقافة الخليجية.
              </p>
            </div>
          </div>
        </section>

        <!-- Specific FAQ for 21 Karat -->
        <section class="mb-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">أسئلة وإجابات سريعة حول عيار 21</h2>
          <div class="space-y-4">
            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>كم تبلغ مصنعية الذهب عيار 21 في السعودية؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                تتراوح المصنعية لعيار 21 عادة بين 15 إلى 45 ريالاً للجرام الواحد، وذلك يعتمد على دقة التصميم، ونوع الماركة (محلي أو خليجي أو إيطالي)، وسياسة المحل التجاري.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>أيهما أفضل للاستثمار: الجنيه عيار 21 أم سبيكة 24؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                سبيكة عيار 24 هي الأفضل للاستثمار البحت لأنها معفاة من الضريبة بالكامل ونسبة نقائها 99.9%. لكن الجنيه السعودي عيار 21 يعتبر خياراً ممتازاً أيضاً لسهولة تسييله وبيعه وانخفاض مصنعيته.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>كيف أتأكد من أن الذهب عيار 21 أصلي؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                ابحث عن الدمغة الرسمية المحفورة على القطعة. عيار 21 يُدمغ عادة برقم (875) أو (21K). واحرص دائماً على الشراء من محلات معتمدة مع طلب الفاتورة الضريبية الرسمية المفصلة.
              </p>
            </details>
          </div>
        </section>

      </main>

      <!-- SIDEBAR COLUMN (4 Columns) -->
      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          
          <!-- CTA to live rates -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3 text-lg">⚖️ هل بلغ ذهبك النصاب؟</h3>
             <a href="/zakat-calculator" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               استخدم حاسبة الزكاة مجاناً
             </a>
          </div>

          <!-- Vertical AdSense Placeholder -->
          <div class="w-full h-[600px] bg-gray-50 border border-gray-200 flex flex-col items-center justify-center rounded-xl text-gray-500 text-sm">
             <span class="mb-2 text-2xl">🪙</span>
             <span>[مساحة إعلانية عمودية]</span>
             <span class="text-xs mt-1 text-gray-400">SkyScraper Ad (300x600)</span>
          </div>

        </div>
      </aside>

    </div>
  </div>

  <script>
  async function fetchLive21KRates() {
    try {
      const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
      const data = await response.json();
      
      // Update Time Badge
      const saudiTime = new Date().toLocaleTimeString('ar-SA', { 
        hour: '2-digit', 
        minute: '2-digit', 
        timeZone: 'Asia/Riyadh' 
      });
      const timeElements = document.querySelectorAll('.live-timestamp');
      timeElements.forEach(el => el.textContent = saudiTime);

      // Hydrate 21K Specific Table
      const tbody = document.getElementById('rates21k-table-body');
      if (tbody && data.rates && data.rates["21K"]) {
        const buy21k = parseFloat(data.rates["21K"].gram_buy);
        const sell21k = parseFloat(data.rates["21K"].gram_sell);
        const pound = parseFloat(data.units.pound_21k_sar);

        tbody.innerHTML = `
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">1 جرام عيار 21</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${buy21k.toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${sell21k.toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">5 جرام عيار 21</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy21k * 5).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell21k * 5).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">10 جرام عيار 21</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy21k * 10).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell21k * 10).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">تولة عيار 21 (11.66 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold whitespace-nowrap">${(buy21k * 11.66).toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold whitespace-nowrap">${(sell21k * 11.66).toFixed(2)} ر.س</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors bg-amber-50/30">
            <td class="py-3.5 px-4 font-bold text-gray-900 whitespace-nowrap">جنيه ذهب سعودي (8 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-bold whitespace-nowrap">${pound.toFixed(2)} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-bold whitespace-nowrap">${(sell21k * 8).toFixed(2)} ر.س</td>
          </tr>
        `;
      }
    } catch (error) {
      console.error('Error fetching live gold rates:', error);
    }
  }

  // Execute immediately
  fetchLive21KRates();
  </script>
</Layout>