---
import Layout from '../layouts/Layout.astro';
import GoldCalculator from '../components/GoldCalculator.astro';

const lastUpdated = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});

// Fallback static data while client-side fetches live rates
const rates = [
  { carat: 'عيار 24 (ذهب خالص)', buySAR: '315.50', sellSAR: '312.20', usd: '$84.13' },
  { carat: 'عيار 22 (تداول الخليج)', buySAR: '289.20', sellSAR: '286.00', usd: '$77.12' },
  { carat: 'عيار 21 (الأكثر تداولاً)', buySAR: '276.10', sellSAR: '273.20', usd: '$73.62' },
  { carat: 'عيار 18 (مشغولات عصرية)', buySAR: '236.60', sellSAR: '234.10', usd: '$63.09' },
  { carat: 'تولة الذهب (11.66 جرام)', buySAR: '3,680.00', sellSAR: '-', usd: '-' },
  { carat: 'أوقية / أونصة الذهب', buySAR: '9,812.05', sellSAR: '-', usd: '$2,616.50' }
];

const bullions = [
  { item: 'جنيه الذهب السعودي (8 جرام عيار 21)', priceSAR: '2,208.80', tax: 'معفى من الضريبة' },
  { item: 'نصف جنيه ذهب (4 جرام عيار 21)', priceSAR: '1,104.40', tax: 'معفى من الضريبة' },
  { item: 'سبيكة ذهب 1 جرام (عيار 24)', priceSAR: '347.00', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 5 جرام (عيار 24)', priceSAR: '1,640.60', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 10 جرام (عيار 24)', priceSAR: '3,218.10', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 50 جرام (عيار 24)', priceSAR: '15,853.00', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 100 جرام (عيار 24)', priceSAR: '31,644.00', tax: 'معفى (نقاء 99%)' },
  { item: 'كيلو ذهب (1000 جرام عيار 24)', priceSAR: '315,500.00', tax: 'معفى (نقاء 99%)' }
];
---

<Layout 
  title="سعر الذهب اليوم في السعودية بيع وشراء عيار 21 و 24 | تحديث مباشر"
  description="تابع أسعار الذهب اليوم في السعودية بيع وشراء لجميع الأعيرة (عيار 21، عيار 24، عيار 18)، مع أسعار السبائك والجنيه الذهب وحساب المصنعية وضريبة القيمة المضافة."
>
  <nav class="max-w-7xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 space-x-reverse">
      <li><a href="/" class="hover:text-gold-700 font-medium">الرئيسية</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-gold-700 font-semibold">أسعار الذهب مباشر في السعودية</li>
    </ol>
  </nav>

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
       تحديث فوري من بورصة المعادن: بتوقيت الرياض (<span class="live-timestamp">{lastUpdated}</span>)
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        أسعار الذهب اليوم في السعودية بيع وشراء عيار 21 والسبائك
      </h1>
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed">
        جدول التسعير المباشر لأسعار الذهب بالريال السعودي والدولار الأمريكي، محدث لحظياً لأسواق الذهب في الرياض، جدة، والدمام. تشمل البيانات سعر الذهب الخام، وسعر البيع للأفراد، وسعر الشراء بالمصنعية والضريبة.
      </p>
    </header>

    <!-- The 12-Column Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN CONTENT (8 Columns) -->
      <main class="lg:col-span-8 space-y-10">
        
        <!-- AdSense Top Banner Placeholder -->
        <div class="w-full min-h-[90px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          <!-- Google AdSense Code will inject here -->
          [مساحة إعلانية]
        </div>

        <!-- Main Live Rates Table -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex flex-wrap justify-between items-center gap-2">
            <h2 class="font-bold text-base md:text-lg text-gray-800">أسعار جرام الذهب في محلات الصاغة السعودية (بدون مصنعية)</h2>
            <span class="text-xs font-semibold text-amber-900 bg-amber-100 px-2 py-1 rounded">العملة: ريال سعودي (SAR)</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4">العيار والنقاء</th>
                  <th class="py-3 px-4">سعر البيع للمستهلك (كاش مستعمل)</th>
                  <th class="py-3 px-4">سعر الشراء من المحل (جديد خام)</th>
                  <th class="py-3 px-4">السعر بالدولار ($)</th>
                </tr>
              </thead>
              <tbody id="rates-table-body" class="divide-y divide-gray-200 text-sm">
                {rates.map((row) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900">{row.carat}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-semibold">{row.buySAR} {row.buySAR !== '-' ? 'ر.س' : ''}</td>
                    <td class="py-3.5 px-4 text-gray-800 font-semibold">{row.sellSAR} {row.sellSAR !== '-' ? 'ر.س' : ''}</td>
                    <td class="py-3.5 px-4 text-gray-500 font-mono" dir="ltr">{row.usd}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
            * ملحوظة دقيقة للمستهلك: سعر البيع هو السعر الصافي عند بيع ذهبك القديم للمحل بدون مصنعية. سعر الشراء الجديد يضاف عليه مصنعية تتراوح بين 15 إلى 55 ريال للجرام حسب التصميم والماركة.
          </div>
        </section>

        <!-- Bullion & Pounds Section -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex justify-between items-center">
            <h2 class="font-bold text-base md:text-lg text-gray-800">أسعار سبائك الذهب والجنيهات الاستثمارية في السعودية</h2>
            <span class="text-xs text-gold-700 font-bold">معفاة من الضريبة</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
              <thead>
                <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
                  <th class="py-3 px-4">الوزن / الصنف</th>
                  <th class="py-3 px-4">السعر التقديري (SAR)</th>
                  <th class="py-3 px-4">موقف ضريبة القيمة المضافة (VAT)</th>
                </tr>
              </thead>
              <tbody id="bullion-table-body" class="divide-y divide-gray-200 text-sm">
                {bullions.map((b) => (
                  <tr class="hover:bg-amber-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-gray-900">{b.item}</td>
                    <td class="py-3.5 px-4 text-gold-700 font-bold">{b.priceSAR} ر.س</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">{b.tax}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Interactive Gold Calculator Component -->
        <GoldCalculator />

        <!-- AdSense Middle Content Placeholder -->
        <div class="w-full min-h-[250px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          <!-- Google AdSense Square/Responsive Code will inject here -->
          [مساحة إعلانية أفقية داخل المحتوى]
        </div>

        <!-- Educational & AEO Content Block -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-lg text-gray-900 mb-2">كيفية حساب مصنعية الذهب في السعودية</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              تُحسب التكلفة الإجمالية لشراء الذهب الجديد عبر المعادلة: 
              <strong class="text-gray-800 bg-gray-50 px-2 py-1 rounded block mt-2 mb-2 border border-gray-100 text-center">إجمالي السعر = (الوزن × سعر الجرام الخام) + (الوزن × المصنعية) + 15% ضريبة مصنعية</strong> 
              السبائك الاستثمارية ذات النقاء 99% معفاة نظاماً من ضريبة القيمة المضافة في المملكة.
            </p>
          </article>

          <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-shadow">
            <h3 class="font-bold text-lg text-gray-900 mb-2">كيفية حساب نصاب زكاة الذهب بالريال</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              نصاب زكاة الذهب الشرعي هو <strong>85 جراماً من عيار 24</strong> (أو ما يعادل 97.14 جراماً من عيار 21). إذا حال الحول وبلغ الذهب المدخر هذا النصاب، يُخرج ربع العشر (2.5%) من إجمالي قيمته السوقية الحالية.
            </p>
          </article>
        </section>

        <!-- FAQ Accordion Block (Expanded for AEO) -->
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">الأسئلة الشائعة حول أسعار الذهب في السعودية</h2>
          <div class="space-y-4">
            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>ما الفرق بين سعر بيع الذهب وشراء الذهب في المحلات؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                سعر الشراء هو المبلغ الذي يدفعه المستهلك للصائغ (ويشمل الخام والمصنعية والضريبة). أما سعر البيع فهو السعر الذي يتقاضاه الزبون عند بيع قطعه القديمة أو السبائك للمحل، ويحسب حصراً على الوزن الصافي للذهب بدون مصنعية.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>هل توجد ضريبة على بيع الذهب المستعمل في السعودية؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                لا، بيع المستهلك لذهبه المستعمل لمحلات الصاغة لا يخضع لأي ضريبة قيمة مضافة. الضريبة البالغة 15% تُطبق فقط على أجور الصياغة (المصنعية) عند شراء المشغولات الذهبية الجديدة.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>ما هو أفضل عيار لحفظ المال والاستثمار؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                السبائك عيار 24 هي الخيار الأمثل للاستثمار لأنها لا تفقد قيمتها في المصنعية ومعفاة من الضريبة. يليها الجنيه الذهب عيار 21 لانخفاض تكلفة مصنعيته وسهولة تداوله في السوق.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>لماذا يختلف سعر الذهب بين محل وآخر؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                سعر الذهب الخام (الشاشة العالمية) ثابت في جميع المحلات. الاختلاف يكمن فقط في "المصنعية" (أجرة التاجر)، والتي تتراوح عادة بين 15 إلى 55 ريالاً للجرام حسب تعقيد التصميم والماركة، بالإضافة لضريبة القيمة المضافة المحسوبة على هذه المصنعية.
              </p>
            </details>
          </div>
        </section>

      </main>

      <!-- SIDEBAR COLUMN (4 Columns - Sticky AdSense Placement) -->
      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          
          <!-- Call to Action Widget -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3">هل بلغ ذهبك النصاب؟</h3>
             <a href="/zakat-calculator" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               استخدم حاسبة الزكاة مجاناً
             </a>
          </div>

          <!-- Vertical AdSense Placeholder -->
          <div class="w-full h-[600px] bg-gray-50 border border-gray-200 flex flex-col items-center justify-center rounded-xl text-gray-500 text-sm">
             <span class="mb-2 text-2xl">🪙</span>
             <span>[مساحة إعلانية عمودية]</span>
             <span class="text-xs mt-1 text-gray-300">SkyScraper Ad (300x600)</span>
          </div>

        </div>
      </aside>

    </div>
  </div>
  
  <script>
  async function fetchLiveRates() {
    try {
      const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
      const data = await response.json();
      
      // 1. Calculate the exact current Riyadh time dynamically in the browser
const saudiTime = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});

const timeElements = document.querySelectorAll('.live-timestamp');
timeElements.forEach(el => el.textContent = saudiTime);

      // 2. Hydrate Main Rates Table
      const tbody = document.getElementById('rates-table-body');
      if (tbody && data.rates) {
        tbody.innerHTML = Object.values(data.rates).map(row => `
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900">${row.karat} <span class="text-xs text-gray-500 font-normal">(${row.purity})</span></td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold">${row.gram_buy} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold">${row.gram_sell} ر.س</td>
            <td class="py-3.5 px-4 text-gray-500 font-mono" dir="ltr">$${row.usd}</td>
          </tr>
        `).join('') + `
          <tr class="hover:bg-amber-50/40 transition-colors bg-gray-50">
            <td class="py-3.5 px-4 font-bold text-gray-900 border-t border-gray-100">تولة الذهب (11.66 جرام)</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold border-t border-gray-100">${data.units.tola_sar} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold border-t border-gray-100">-</td>
            <td class="py-3.5 px-4 text-gray-500 font-mono border-t border-gray-100" dir="ltr">-</td>
          </tr>
          <tr class="hover:bg-amber-50/40 transition-colors bg-gray-50">
            <td class="py-3.5 px-4 font-bold text-gray-900">أوقية / أونصة الذهب</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold">${data.units.ounce_sar} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold">-</td>
            <td class="py-3.5 px-4 text-gray-500 font-mono" dir="ltr">$${data.spot_usd_oz}</td>
          </tr>
        `;
      }

      // 3. Hydrate Bullion Table
      const bullionBody = document.getElementById('bullion-table-body');
      if (bullionBody && data.rates["24K"] && data.units) {
        const g24 = parseFloat(data.rates["24K"].gram_buy);
        const pound = parseFloat(data.units.pound_21k_sar);
        
        bullionBody.innerHTML = `
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">جنيه الذهب السعودي (8 جرام عيار 21)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${pound.toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى من الضريبة</td></tr>
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">نصف جنيه ذهب (4 جرام عيار 21)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${(pound / 2).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى من الضريبة</td></tr>
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 1 جرام (عيار 24)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${(g24 * 1).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى (نقاء 99%)</td></tr>
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 5 جرام (عيار 24)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${(g24 * 5).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى (نقاء 99%)</td></tr>
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 10 جرام (عيار 24)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${(g24 * 10).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى (نقاء 99%)</td></tr>
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 50 جرام (عيار 24)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${(g24 * 50).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى (نقاء 99%)</td></tr>
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">سبيكة ذهب 100 جرام (عيار 24)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${(g24 * 100).toFixed(2)} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى (نقاء 99%)</td></tr>
          <tr class="hover:bg-amber-50/40 transition-colors"><td class="py-3.5 px-4 font-bold text-gray-900">كيلو ذهب (1000 جرام عيار 24)</td><td class="py-3.5 px-4 text-gold-700 font-bold">${data.units.kilo_sar} ر.س</td><td class="py-3.5 px-4 text-emerald-700 font-medium text-xs md:text-sm">معفى (نقاء 99%)</td></tr>
        `;
      }

      // 4. Pass live 24K rate to the Gold Calculator component
      window.currentGram24K = parseFloat(data.rates["24K"].gram_buy);
      if (typeof window.recalculateGold === 'function') {
        window.recalculateGold();
      }

    } catch (error) {
      console.error('Error fetching live gold rates:', error);
    }
  }

  // Execute immediately
  fetchLiveRates();
  </script>
