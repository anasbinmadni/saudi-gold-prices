---
import Layout from '../layouts/Layout.astro';

const lastUpdated = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});

const rates = [
  { carat: 'عيار 24 (ذهب خالص 99.9%)', buySAR: '315.50', sellSAR: '312.20', usd: '$84.13' },
  { carat: 'عيار 22 (تداول الخليج)', buySAR: '289.20', sellSAR: '286.00', usd: '$77.12' },
  { carat: 'عيار 21 (الأكثر تداولاً)', buySAR: '276.10', sellSAR: '273.20', usd: '$73.62' },
  { carat: 'عيار 18 (مشغولات عصرية)', buySAR: '236.60', sellSAR: '234.10', usd: '$63.09' },
  { carat: 'عيار 14', buySAR: '184.00', sellSAR: '181.50', usd: '$49.06' },
  { carat: 'أوقية / أونصة الذهب (31.1 جرام)', buySAR: '9,812.05', sellSAR: '9,709.42', usd: '$2,616.50' }
];

const bullions = [
  { item: 'جنيه الذهب السعودي (8 جرام عيار 21)', priceSAR: '2,208.80', tax: 'معفى من الضريبة' },
  { item: 'نصف جنيه ذهب (4 جرام عيار 21)', priceSAR: '1,104.40', tax: 'معفى من الضريبة' },
  { item: 'سبيكة ذهب 1 جرام (عيار 24)', priceSAR: '347.00', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 5 جرام (عيار 24)', priceSAR: '1,640.60', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 10 جرام (عيار 24)', priceSAR: '3,218.10', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 50 جرام (عيار 24)', priceSAR: '15,853.00', tax: 'معفى (نقاء 99%)' },
  { item: 'سبيكة ذهب 100 جرام (عيار 24)', priceSAR: '31,644.00', tax: 'معفى (نقاء 99%)' },
  { item: 'كيلو ذهب (1000 جرام عيار 24)', priceSAR: '315,500.00', tax: 'معفى (نقاء 99%)' }
];
---

<Layout 
  title="سعر الذهب اليوم في السعودية بيع وشراء عيار 21 و 24 | تحديث مباشر"
  description="تابع أسعار الذهب اليوم في السعودية بيع وشراء لجميع الأعيرة (عيار 21، عيار 24، عيار 18)، مع أسعار السبائك والجنيه الذهب وحساب المصنعية وضريبة القيمة المضافة."
>
  <nav class="max-w-6xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 space-x-reverse">
      <li><a href="/" class="hover:text-gold-700 font-medium">الرئيسية</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-gold-700 font-semibold">أسعار الذهب مباشر في السعودية</li>
    </ol>
  </nav>

  <main class="max-w-6xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-3">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
       تحديث فوري من بورصة المعادن: بتوقيت الرياض (<span class="live-timestamp">{lastUpdated}</span>)
      </div>
      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        أسعار الذهب اليوم في السعودية بيع وشراء عيار 21 والسبائك
      </h1>
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed">
        جدول التسعير المباشر لأسعار الذهب بالريال السعودي والدولار الأمريكي، محدث لحظياً لأسواق الذهب في الرياض، جدة، والدمام. تشمل البيانات سعر الذهب الخام، وسعر البيع للأفراد، وسعر الشراء بالمصنعية والضريبة.
      </p>
    </header>

    <!-- Main Live Rates Table -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-10">
      <div class="px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex flex-wrap justify-between items-center gap-2">
        <h2 class="font-bold text-base md:text-lg text-gray-800">أسعار جرام الذهب في محلات الصاغة السعودية (بدون مصنعية)</h2>
        <span class="text-xs font-semibold text-amber-900 bg-amber-100 px-2 py-1 rounded">العملة: ريال سعودي (SAR)</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
              <th class="py-3 px-4">العيار والنقاء</th>
              <th class="py-3 px-4">سعر البيع للمستهلك (كاش مستعمل)</th>
              <th class="py-3 px-4">سعر الشراء من المحل (جديد خام)</th>
              <th class="py-3 px-4">السعر بالدولار ($)</th>
            </tr>
          </thead>
          <tbody id="rates-table-body" class="divide-y divide-gray-200 text-sm">
            {rates.map((row) => (
              <tr class="hover:bg-amber-50/40 transition-colors">
                <td class="py-3.5 px-4 font-bold text-gray-900">{row.carat}</td>
                <td class="py-3.5 px-4 text-emerald-700 font-semibold">{row.buySAR} ر.س</td>
                <td class="py-3.5 px-4 text-gray-800 font-semibold">{row.sellSAR} ر.س</td>
                <td class="py-3.5 px-4 text-gray-500 font-mono">{row.usd}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="px-6 py-3 bg-gray-50 text-xs text-gray-500 border-t border-gray-100 leading-relaxed">
        * ملحوظة دقيقة للمستهلك: سعر البيع هو السعر الصافي عند بيع ذهبك القديم للمحل بدون مصنعية. سعر الشراء الجديد يضاف عليه مصنعية تتراوح بين 15 إلى 55 ريال للجرام حسب التصميم والماركة.
      </div>
    </section>

    <!-- Bullion & Pounds Section -->
    <section class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-10">
      <div class="px-6 py-4 border-b border-gray-200 bg-amber-50/50 flex justify-between items-center">
        <h2 class="font-bold text-base md:text-lg text-gray-800">أسعار سبائك الذهب والجنيهات الاستثمارية في السعودية</h2>
        <span class="text-xs text-gold-700 font-bold">معفاة من الضريبة</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="bg-gray-100 text-gray-700 text-xs md:text-sm font-semibold border-b">
              <th class="py-3 px-4">الوزن / الصنف</th>
              <th class="py-3 px-4">السعر التقديري (SAR)</th>
              <th class="py-3 px-4">موقف ضريبة القيمة المضافة (VAT)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-sm">
            {bullions.map((b) => (
              <tr class="hover:bg-amber-50/40 transition-colors">
                <td class="py-3.5 px-4 font-bold text-gray-900">{b.item}</td>
                <td class="py-3.5 px-4 text-gold-700 font-bold">{b.priceSAR} ر.س</td>
                <td class="py-3.5 px-4 text-emerald-600 font-medium text-xs md:text-sm">{b.tax}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Educational & AEO Content Block -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm">
        <h3 class="font-bold text-lg text-gray-900 mb-2">كيفية حساب مصنعية الذهب في السعودية</h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          تُحسب التكلفة الإجمالية لشراء الذهب الجديد عبر المعادلة: 
          <strong class="text-gray-800">إجمالي السعر = (وزن القطعة × سعر الجرام الخام) + (وزن القطعة × قيمة المصنعية) + 15% ضريبة على المصنعية فقط</strong>. السبائك الاستثمارية ذات النقاء 99% معفاة نظاماً من ضريبة القيمة المضافة في المملكة.
        </p>
      </article>

      <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm">
        <h3 class="font-bold text-lg text-gray-900 mb-2">كيفية حساب نصاب زكاة الذهب بالريال</h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          نصاب زكاة الذهب الشرعي هو <strong>85 جراماً من عيار 24</strong> (أو ما يعادل 97.14 جراماً من عيار 21). إذا حال الحول وبلغ الذهب المدخر هذا النصاب، يُخرج ربع العشر (2.5%) من إجمالي قيمته السوقية الحالية.
        </p>
      </article>
    </section>

    <!-- FAQ Accordion Block -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 mb-4">الأسئلة الشائعة حول أسعار الذهب في السعودية</h2>
      <div class="space-y-3">
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
          <h3 class="font-semibold text-gray-900 mb-1">ما الفرق بين سعر بيع الذهب وشراء الذهب في المحلات؟</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            سعر الشراء هو المبلغ الذي يدفعه المستهلك للصائغ (ويشمل الخام والمصنعية والضريبة). أما سعر البيع فهو السعر الذي يتقاضاه الزبون عند بيع قطعه القديمة أو السبائك للمحل، ويحسب حصراً على الوزن الصافي للذهب بدون مصنعية.
          </p>
        </div>
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
          <h3 class="font-semibold text-gray-900 mb-1">هل توجد ضريبة على بيع الذهب المستعمل في السعودية؟</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            لا، بيع المستهلك لذهبه المستعمل لمحلات الصاغة لا يخضع لأي ضريبة قيمة مضافة. الضريبة البالغة 15% تُطبق فقط على أجور الصياغة (المصنعية) عند شراء المشغولات الذهبية الجديدة.
          </p>
        </div>
      </div>
    </section>
  </main>
  <script>
  async function fetchLiveRates() {
    try {
      // Replace with your actual Cloudflare Worker URL
      const response = await fetch('https://saudi-gold-api.YOUR-USERNAME.workers.dev');
      const data = await response.json();
      
      // Update the timestamp on the page
      const timeElements = document.querySelectorAll('.live-timestamp');
      timeElements.forEach(el => el.textContent = data.timestamp);

      // Example of mapping the live data into your HTML table
      // To make this work, give your <tbody> an id="rates-table-body" in your HTML above
      const tbody = document.getElementById('rates-table-body');
      if (tbody) {
        tbody.innerHTML = data.rates.map(row => `
          <tr class="hover:bg-amber-50/40 transition-colors">
            <td class="py-3.5 px-4 font-bold text-gray-900">${row.carat}</td>
            <td class="py-3.5 px-4 text-emerald-700 font-semibold">${row.buySAR} ر.س</td>
            <td class="py-3.5 px-4 text-gray-800 font-semibold">${row.sellSAR} ر.س</td>
            <td class="py-3.5 px-4 text-gray-500 font-mono">$${row.usd}</td>
          </tr>
        `).join('');
      }
    } catch (error) {
      console.error('Error fetching live gold rates:', error);
    }
  }

  // Fetch immediately on load
  fetchLiveRates();
</script>
</Layout>