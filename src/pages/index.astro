---
import Layout from '../layouts/Layout.astro';
import GoldCalculator from '../components/GoldCalculator.astro';
import GoldRatesTable from '../components/GoldRatesTable.astro';
import BullionPoundsTable from '../components/BullionPoundsTable.astro';

const lastUpdated = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});
---

<Layout 
  title="سعر الذهب اليوم في السعودية بيع وشراء عيار 21 و 24 | تحديث مباشر"
  description="تابع أسعار الذهب اليوم في السعودية بيع وشراء لجميع الأعيرة (عيار 21، عيار 24، عيار 18)، مع أسعار السبائك والجنيه الذهب وحساب المصنعية وضريبة القيمة المضافة."
>
  <nav class="max-w-7xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 space-x-reverse">
      <li><a href="/" class="hover:text-gold-700 font-medium transition">الرئيسية</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-gold-700 font-semibold" aria-current="page">أسعار الذهب مباشر في السعودية</li>
    </ol>
  </nav>

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      
      <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs md:text-sm font-semibold mb-4 shadow-sm">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span>تحديث فوري 🇸🇦 بتوقيت الرياض:</span>
        <span class="live-timestamp bg-white px-2 py-0.5 rounded text-emerald-900 shadow-sm border border-emerald-100 whitespace-nowrap" dir="ltr">{lastUpdated}</span>
      </div>

      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
        أسعار الذهب اليوم في السعودية بيع وشراء عيار 21 والسبائك
      </h1>
      
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed">
        جدول التسعير المباشر لأسعار الذهب بالريال السعودي والدولار الأمريكي، محدث لحظياً لأسواق الذهب في <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-medium">الرياض، جدة، والدمام</span>. تشمل البيانات سعر الذهب الخام، وسعر البيع للأفراد، و<span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">سعر الشراء بالمصنعية والضريبة</span>.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN CONTENT (8 Columns) -->
      <main class="lg:col-span-8 space-y-10">
        
        <div class="w-full min-h-[90px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          [مساحة إعلانية]
        </div>

        <!-- Render Component Client-Side Visible -->
        <GoldRatesTable client:visible />

        <!-- Render Component Client-Side Visible -->
        <BullionPoundsTable client:visible />

        <!-- Render Component Client-Side Visible -->
        <GoldCalculator client:visible />

        <div class="w-full min-h-[250px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          [مساحة إعلانية أفقية داخل المحتوى]
        </div>

        <!-- SEO Sections remain static in the main file -->
        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6 border-r-4 border-gold-500 pr-3">دليل مشتري الذهب في السوق السعودي</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>💡</span> أي عيار تختار؟
              </h3>
              <ul class="space-y-4 text-sm text-gray-600">
                <li class="leading-relaxed"><span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">عيار 24:</span> الذهب الخالص (نقاء 99.9%). الخيار الأول لحفظ الثروة لعدم وجود مصنعية مرتفعة أو ضرائب.</li>
                <li class="leading-relaxed"><span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">عيار 21:</span> الأكثر شعبية في السعودية. يمتاز بلون أصفر غني ومتانة لصناعة الحلي والجنيهات.</li>
                <li class="leading-relaxed"><span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">عيار 18:</span> المفضل للمشغولات العصرية ذات الفصوص، حيث تمنحه إضافة المعادن صلابة استثنائية.</li>
              </ul>
            </div>
            <div>
              <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                <span>🛒</span> نصائح ذهبية قبل الشراء
              </h3>
              <ul class="space-y-4 text-sm text-gray-600">
                <li class="leading-relaxed"><strong class="text-gray-900">الدمغة الرسمية:</strong> تأكد دائماً من وجود ختم العيار (مثل 875 لعيار 21) وعلامة الشركة المصنعة.</li>
                <li class="leading-relaxed"><strong class="text-gray-900">الفاتورة الإلكترونية:</strong> اطلب الفاتورة الضريبية الموضحة <span class="bg-emerald-100 text-emerald-900 px-1.5 py-0.5 rounded font-medium">للوزن الصافي، والمصنعية</span> لضمان حقوقك.</li>
                <li class="leading-relaxed"><strong class="text-gray-900">الأحجار والفصوص:</strong> استفسر من البائع إذا ما كان سيتم خصم وزن الفصوص عند إعادة البيع.</li>
              </ul>
            </div>
          </div>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
          <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-shadow flex flex-col h-full">
            <h3 class="font-bold text-lg text-gray-900 mb-3 flex items-center gap-2">
              <span>🧾</span> حساب مصنعية الذهب
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed flex-grow">
              تُحسب التكلفة الإجمالية لشراء الذهب الجديد عبر المعادلة: 
              <strong class="text-amber-900 bg-amber-50 px-3 py-2 rounded-lg block mt-3 mb-3 border border-amber-100 text-center shadow-sm">إجمالي السعر = (الوزن × سعر الجرام) + (الوزن × المصنعية) + 15% ضريبة</strong> 
              السبائك الاستثمارية ذات النقاء 99% <span class="bg-emerald-100 text-emerald-900 px-1 rounded font-medium">معفاة نظاماً</span> من ضريبة القيمة المضافة.
            </p>
          </article>

          <article class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-shadow flex flex-col h-full">
            <h3 class="font-bold text-lg text-gray-900 mb-3 flex items-center gap-2">
              <span>⚖️</span> نصاب زكاة الذهب
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed flex-grow">
              نصاب زكاة الذهب الشرعي هو <span class="bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded font-bold">85 جراماً من عيار 24</span> (أو ما يعادل 97.14 جرام من عيار 21). إذا حال الحول، يُخرج ربع العشر (2.5%) من إجمالي قيمته السوقية.
            </p>
          </article>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">الأسئلة الشائعة حول أسعار الذهب في السعودية</h2>
          <div class="space-y-4">
            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>ما الفرق بين سعر بيع الذهب وشراء الذهب في المحلات؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                سعر الشراء هو المبلغ الذي يدفعه المستهلك للصائغ (ويشمل الخام والمصنعية والضريبة). أما سعر البيع فهو السعر الذي يتقاضاه الزبون عند بيع قطعه القديمة أو السبائك للمحل، ويحسب حصراً على الوزن الصافي للذهب بدون مصنعية.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>هل توجد ضريبة على بيع الذهب المستعمل في السعودية؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                لا، بيع المستهلك لذهبه المستعمل لمحلات الصاغة لا يخضع لأي ضريبة قيمة مضافة. الضريبة البالغة 15% تُطبق فقط على أجور الصياغة (المصنعية) عند شراء المشغولات الذهبية الجديدة.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>ما هو أفضل عيار لحفظ المال والاستثمار؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                السبائك عيار 24 هي الخيار الأمثل للاستثمار لأنها لا تفقد قيمتها في المصنعية ومعفاة من الضريبة. يليها الجنيه الذهب عيار 21 لانخفاض تكلفة مصنعيته وسهولة تداوله في السوق.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>لماذا يختلف سعر الذهب بين محل وآخر؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                سعر الذهب الخام (الشاشة العالمية) ثابت في جميع المحلات. الاختلاف يكمن فقط في "المصنعية" (أجرة التاجر)، والتي تتراوح عادة بين 15 إلى 55 ريالاً للجرام حسب تعقيد التصميم والماركة، بالإضافة لضريبة القيمة المضافة المحسوبة على هذه المصنعية.
              </p>
            </details>
          </div>
        </section>

      </main>

      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3 text-lg">⚖️ هل بلغ ذهبك النصاب؟</h3>
             <a href="/zakat-calculator" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               استخدم حاسبة الزكاة مجاناً
             </a>
          </div>

          <div class="w-full h-[600px] bg-gray-50 border border-gray-200 flex flex-col items-center justify-center rounded-xl text-gray-500 text-sm">
             <span class="mb-2 text-2xl">🪙</span>
             <span>[مساحة إعلانية عمودية]</span>
             <span class="text-xs mt-1 text-gray-400">SkyScraper Ad (300x600)</span>
          </div>
        </div>
      </aside>

    </div>
  </div>
  
  <script>
    // Just fetch the time for the header badge. The components will fetch their own data.
    const saudiTime = new Date().toLocaleTimeString('ar-SA', { 
      hour: '2-digit', 
      minute: '2-digit', 
      timeZone: 'Asia/Riyadh' 
    });
    const timeElements = document.querySelectorAll('.live-timestamp');
    timeElements.forEach(el => el.textContent = saudiTime);
  </script>
</Layout>