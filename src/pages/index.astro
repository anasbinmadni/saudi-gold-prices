        `;
      }

      // 4. Pass live 24K rate to the Gold Calculator component
      window.currentGram24K = parseFloat(data.rates["24K"].gram_buy);
      if (typeof window.recalculateGold === 'function') {
        window.recalculateGold();
      }

    } catch (error) {
      console.error('Error fetching live gold rates:', error);
    }
  }

  // Execute immediately
  fetchLiveRates();
  </script>
