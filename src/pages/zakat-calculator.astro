---
import Layout from '../layouts/Layout.astro';

const lastUpdated = new Date().toLocaleTimeString('ar-SA', { 
  hour: '2-digit', 
  minute: '2-digit', 
  timeZone: 'Asia/Riyadh' 
});
---

<Layout 
  title="حاسبة زكاة الذهب بالريال السعودي | حساب النصاب المباشر"
  description="احسب زكاة الذهب الخاص بك بدقة بناءً على الأسعار المباشرة في السعودية. أداة مجانية لمعرفة بلوغ النصاب (85 جرام عيار 24) وحساب مقدار الزكاة الواجب إخراجها."
>
  <nav class="max-w-7xl mx-auto px-4 py-4 text-xs md:text-sm text-gray-500" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 space-x-reverse">
      <li><a href="/" class="hover:text-gold-700 font-medium">الرئيسية</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-gold-700 font-semibold">حاسبة زكاة الذهب</li>
    </ol>
  </nav>

  <div class="max-w-7xl mx-auto px-4 pb-16">
    <header class="border-b border-gray-200 pb-6 mb-8 text-right">
      <h1 class="text-2xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-3">
        حاسبة زكاة الذهب المباشرة (بالريال السعودي)
      </h1>
      <p class="text-gray-600 text-sm md:text-base max-w-4xl leading-relaxed">
        تعتمد هذه الحاسبة على السعر اللحظي للذهب في السوق السعودي. النصاب الشرعي لزكاة الذهب هو <strong>85 جراماً من الذهب الخالص (عيار 24)</strong>، ومقدار الزكاة الواجب إخراجها هو ربع العشر (2.5%).
      </p>
    </header>

    <!-- The 12-Column Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN CONTENT (8 Columns) -->
      <main class="lg:col-span-8 space-y-10">
        
        <!-- AdSense Top Banner Placeholder -->
        <div class="w-full min-h-[90px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          <!-- Google AdSense Code will inject here -->
          [مساحة إعلانية أفقية]
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Calculator Input Section -->
          <section class="md:col-span-1 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">أدخل بيانات الذهب</h2>
            
            <div class="space-y-4">
              <div>
                <label for="zakat-karat" class="block text-sm font-semibold text-gray-700 mb-1">عيار الذهب</label>
                <select id="zakat-karat" class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-500">
                  <option value="24">عيار 24 (ذهب خالص)</option>
                  <option value="22">عيار 22</option>
                  <option value="21" selected>عيار 21</option>
                  <option value="18">عيار 18</option>
                </select>
              </div>

              <div>
                <label for="zakat-weight" class="block text-sm font-semibold text-gray-700 mb-1">الوزن الكلي (بالجرام)</label>
                <input type="number" id="zakat-weight" placeholder="مثال: 100" min="0" step="1" class="w-full bg-gray-50 border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-amber-500" />
              </div>
            </div>
          </section>

          <!-- Calculator Output Section -->
          <section class="md:col-span-2 bg-gray-50 rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center">
            <div class="text-center mb-6">
              <span class="inline-block bg-white border border-gray-200 rounded-full px-4 py-1 text-xs text-gray-500 font-semibold mb-2">
                السعر المعتمد: الشاشة العالمية (<span class="live-timestamp">{lastUpdated}</span>)
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-white p-4 rounded-lg border border-gray-200 text-center">
                <span class="block text-sm text-gray-500 mb-1">هل بلغ النصاب؟</span>
                <span id="nisab-status" class="font-bold text-xl text-gray-500">بانتظار الإدخال</span>
                <p id="nisab-note" class="text-[11px] text-gray-500 mt-1">النصاب = 85 جرام عيار 24</p>
              </div>

              <div class="bg-white p-4 rounded-lg border border-gray-200 text-center">
                <span class="block text-sm text-gray-500 mb-1">القيمة السوقية الحالية</span>
                <span id="market-value" class="font-bold text-xl text-gray-900">0.00</span>
                <span class="text-xs text-gray-600">ر.س</span>
              </div>
            </div>

            <div class="mt-4 bg-emerald-50 border border-emerald-200 p-6 rounded-lg text-center">
              <span class="block text-sm text-emerald-800 font-bold mb-1">مقدار الزكاة الواجب إخراجها (2.5%)</span>
              <span id="zakat-due" class="font-extrabold text-4xl text-emerald-700">0.00</span>
              <span class="text-sm font-bold text-emerald-800">ريال سعودي</span>
            </div>
          </section>
        </div>

        <!-- AdSense Middle Content Placeholder -->
        <div class="w-full min-h-[250px] bg-gray-50 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 text-xs text-center" aria-hidden="true">
          <!-- Google AdSense Square/Responsive Code will inject here -->
          [مساحة إعلانية داخل المحتوى]
        </div>

        <!-- FAQ Accordion Block for Zakat (AEO) -->
        <section>
          <h2 class="text-xl font-bold text-gray-900 mb-4 border-r-4 border-amber-500 pr-3">أحكام زكاة الذهب الشائعة</h2>
          <div class="space-y-4">
            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>هل تجب الزكاة في الذهب الملبوس (المعد للزينة)؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                اختلف العلماء في زكاة حلي المرأة المعد للاستعمال والزينة. الأحوط والمفتى به في دار الإفتاء واللجنة الدائمة بالسعودية هو وجوب الزكاة فيه إذا بلغ النصاب (85 جراماً من الذهب الخالص) وحال عليه الحول، وذلك إبراءً للذمة.
              </p>
            </details>

            <details class="group bg-white border border-gray-200 rounded-lg shadow-sm open:shadow-md transition-all">
              <summary class="flex justify-between items-center font-semibold cursor-pointer list-none p-4 text-gray-900">
                <span>كيف يحسب نصاب الذهب لعيار 21 وعيار 18؟</span>
                <span class="transition group-open:rotate-180 text-amber-500">
                  <svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed px-4 pb-4 mt-2 border-t border-gray-100 pt-3">
                النصاب الثابت هو 85 جراماً من عيار 24 (الذهب الخالص). ولمعرفة النصاب للأعيرة الأخرى: يعادل النصاب في عيار 21 حوالي 97.14 جرام، وفي عيار 18 يعادل حوالي 113.33 جرام. الحاسبة بالأعلى تقوم بهذا التحويل تلقائياً.
              </p>
            </details>
          </div>
        </section>

      </main>

      <!-- SIDEBAR COLUMN (4 Columns - Sticky AdSense Placement) -->
      <aside class="lg:col-span-4 space-y-6 hidden lg:block">
        <div class="sticky top-24">
          
          <!-- Call to Action Widget -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 mb-6 text-center">
             <h3 class="font-bold text-gray-900 mb-3">تتابع أسعار الذهب؟</h3>
             <a href="/" class="block w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-lg transition shadow-sm">
               شاهد أسعار الذهب المباشرة اليوم
             </a>
          </div>

          <!-- Vertical AdSense Placeholder -->
          <div class="w-full h-[600px] bg-gray-50 border border-gray-200 flex flex-col items-center justify-center rounded-xl text-gray-500 text-sm">
             <span class="mb-2 text-2xl">🪙</span>
             <span>[مساحة إعلانية عمودية]</span>
             <span class="text-xs mt-1 text-gray-300">SkyScraper Ad (300x600)</span>
          </div>

        </div>
      </aside>

    </div>
  </div>

  <script>
    async function initZakatCalculator() {
      try {
        // Fetch live rates from your actual Cloudflare Worker
        const response = await fetch('https://saudi-gold-api.2019ag138.workers.dev');
        const data = await response.json();
        
        // Update timestamp
        document.querySelectorAll('.live-timestamp').forEach(el => el.textContent = data.timestamp);

        // Extract base 24K price (sell price is used for Zakat evaluation)
        const gram24K = parseFloat(data.rates["24K"].gram_sell);

        function calculateZakat() {
          const karat = document.getElementById('zakat-karat').value;
          const weight = parseFloat(document.getElementById('zakat-weight').value) || 0;

          const karatRatios = { '24': 1, '22': 22/24, '21': 21/24, '18': 18/24 };
          
          // Calculate the pure 24K equivalent weight
          const pureGoldWeight = weight * karatRatios[karat];
          
          // Calculate total market value based on live 24K price
          const marketValue = pureGoldWeight * gram24K;

          // Check Nisab (85 grams of pure gold)
          const reachedNisab = pureGoldWeight >= 85;
          const zakatDue = reachedNisab ? (marketValue * 0.025) : 0;

          // Update UI
          const statusEl = document.getElementById('nisab-status');
          const noteEl = document.getElementById('nisab-note');
          
          if (weight === 0) {
            statusEl.textContent = "بانتظار الإدخال";
            statusEl.className = "font-bold text-xl text-gray-500";
            noteEl.textContent = "النصاب = 85 جرام عيار 24";
          } else if (reachedNisab) {
            statusEl.textContent = "نعم، بلغ النصاب";
            statusEl.className = "font-bold text-xl text-emerald-700";
            noteEl.textContent = `يعادل ${pureGoldWeight.toFixed(2)} جرام عيار 24`;
          } else {
            statusEl.textContent = "لا، لم يبلغ النصاب";
            statusEl.className = "font-bold text-xl text-red-500";
            noteEl.textContent = `يعادل ${pureGoldWeight.toFixed(2)} جرام فقط`;
          }

          document.getElementById('market-value').textContent = marketValue.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
          document.getElementById('zakat-due').textContent = zakatDue.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }

        // Attach event listeners
        document.getElementById('zakat-karat').addEventListener('change', calculateZakat);
        document.getElementById('zakat-weight').addEventListener('input', calculateZakat);

      } catch (error) {
        console.error('Error fetching data for Zakat calculator:', error);
      }
    }

    initZakatCalculator();
  </script>
</Layout>